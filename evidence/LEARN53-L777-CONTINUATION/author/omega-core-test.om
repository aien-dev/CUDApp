fn observationtests to void
for i ulong 256
put LWant i uchar and i 255
put LGot i uchar and i 255
end
check lobserve 0 0 0 8 8 0
put LGot 7 99
check lobserve 0 0 0 8 8 7
check lobserve 0 0 0 8 0 9
