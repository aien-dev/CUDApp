note Native consumer of the standalone emitter's actual stdout bytes.
text passed "EMITTER TO VIRTUAL GPU PASS\n"
fn wirecheck n ulong to int
put used 0 n
rc = int 65
for r ulong 3
for k ulong 4
put mem add mul r 4 k add r k
end
end
for k ulong 4
put mem add 2048 k add k 1
end
for r ulong 32
put mem add 3072 r 3735928559
end
if and eq n 148 eq word 0 4 2114716288
rc = amd_run 3 4
end
if and eq n 218 eq word 0 6 6498
rc = agx_run 3 4
end
if ne rc 0
ret rc
end
note Wolfram independently gives 20,30,40.
if ne get mem 3072 20
ret 1
end
if ne get mem 3073 30
ret 2
end
if ne get mem 3074 40
ret 3
end
for r ulong 29
if ne get mem add 3075 r 3735928559
ret 4
end
end
w = write 1 passed 0 len passed
if ne w long len passed
ret 74
end
ret 0
end
fn main to int
n = ulong 0
for attempt ulong 4097
if ge n len code
ret 65
end
r = read 0 code n sub len code n
if lt r 0
ret 74
end
if eq r 0
ret wirecheck n
end
n = add n ulong r
end
ret 65
end
