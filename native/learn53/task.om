note Caller owns/pins kt; only ko contains candidate observations. No code execution.
global kt uchar 4096
global ko uchar 1032
fn kw i ulong to ulong
v = ulong 0
for j ulong 4
v = or v shl ulong get kt add mul i 4 j mul j 8
end
ret v
end
fn kc i ulong to ulong
v = ulong 0
for j ulong 4
v = or v shl ulong get ko add mul i 4 j mul j 8
end
ret v
end
fn kshape to ulong
op = kw 2
m = kw 5
n = kw 6
k = kw 7
if eq op 3
if eq m 2
if eq n 3
if eq k 2
ret 301
end
end
end
if eq m 3
if eq n 2
if eq k 3
ret 302
end
end
end
ret 0
end
if ne n 1
ret 0
end
if ne k 1
ret 0
end
base = mul op 100
if eq m 3
ret add base 1
end
if eq m 8
ret add base 2
end
if eq m 17
ret add base 3
end
ret 0
end
fn kextent rows ulong cols ulong stride ulong to ulong
ret add mul sub rows 1 stride cols
end
fn kstrides to int
op = kw 2
m = kw 5
if eq op 3
if lt kw 8 kw 7
ret 65
end
if lt kw 9 kw 6
ret 65
end
if lt kw 10 kw 6
ret 65
