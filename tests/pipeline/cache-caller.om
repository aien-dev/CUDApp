note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Actual compiled policy->cache caller; synthetic records, no GPU/model claim.
fn main to int
q = new ulong 64 0
a = new ulong 1024 0
p = new ulong 528 0
o = new ulong 16 0
lease = new ulong 16 0
req = new ulong 16 0
pl_fixture q a
note Existing session recoveries begins at zero: no invented nonzero epoch.
put q 3 0
put a 17 0
put a 81 0
put a 145 0
rc = kc_init p 0 1 128 1
if ne rc 0
ret 1
end
note Selection cannot upload or fabricate residency during graph recording.
if ne pl_pin q a p o lease 75
ret 2
end
if ne get lease 0 0
ret 3
end
put req 0 0
put req 1 1
put req 2 1
put req 7 1
for j ulong 4
put req add 3 j get a add 85 j
end
if ne kc_prepare p req 1
ret 4
end
if ne kc_commit p 0 1 0 0
ret 5
end
if ne pl_pin q a p o lease 0
ret 6
end
if ne get o 1 1
ret 7
end
note Cache identity is the exact chosen canonical artifact, not shape alone.
for j ulong 4
if ne get lease add 4 j get a add 85 j
ret 8
end
end
if ne kc_acquire p get lease 1 get lease 2 get lease 3 0
ret 9
end
if ne kc_retire p get lease 1 get lease 2 get lease 3 0
ret 10
end
if ne kc_unpin p get lease 1 get lease 2 get lease 3 0
ret 11
end
note Recovery invalidates an old selection and old recorded/inflight tokens.
if ne kc_invalidate p 2 1 0
ret 12
end
if ne kc_acquire p get lease 1 get lease 2 get lease 3 -2
ret 13
end
if ne pl_pin q a p o lease 75
ret 14
end
for j ulong 16
if ne get o j 0
ret 15
end
if ne get lease j 0
ret 16
end
end
ret 0
end
