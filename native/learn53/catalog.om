note Eight fixed public development tasks. Not a sealed pool or a process runner.
fn kput p ulong v ulong to void
for i ulong 4
put kt add mul p 4 i uchar and shr v mul i 8 255
end
end
fn kbase id ulong to void
for i ulong 4096
put kt i 0
end
kput 0 827086147
kput 1 1
kput 3 1
kput 5 3
kput 6 1
kput 7 1
kput 8 2
kput 9 2
kput 10 2
kput 11 5
kput 12 5
kput 13 5
kput 14 1
kput 16 id
kput 17 1
kput 19 1
kput 20 1
end
fn klinear id ulong to void
if eq id 1
kput 2 1
kput 15 101
kput 24 4294967295
kput 25 111
kput 26 7
kput 27 222
kput 28 9
kput 29 1
kput 30 333
kput 31 4
kput 32 444
kput 33 6
ret
end
if eq id 4
kput 2 2
kput 15 201
kput 9 0
kput 10 1
kput 12 0
kput 13 1
kput 24 4294967295
kput 25 111
kput 26 2
kput 27 222
kput 28 3
ret
end
n = ulong 8
if or eq id 3 eq id 6
n = 17
end
kput 5 n
kput 8 1
kput 10 1
kput 11 n
if le id 3
kput 2 1
kput 9 1
kput 12 n
kput 13 n
kput 15 add 100 id
a = ulong 7
b = ulong 9
if eq id 3
a = 4294967295
b = 3
end
for i ulong n
kput add 24 i a
kput add add 24 n i b
end
else
kput 2 2
kput 9 0
kput 12 0
kput 13 1
kput 15 add 197 id
for i ulong n
kput add 24 i 4294967295
end
end
end
fn kmatrix id ulong to void
kput 2 3
if eq id 7
kput 5 2
kput 6 3
kput 7 2
kput 8 3
kput 9 4
kput 10 4
kput 11 5
kput 12 7
kput 13 7
kput 15 301
kput 24 1
kput 25 2
kput 26 999
kput 27 3
kput 28 4
kput 29 5
kput 30 6
kput 31 7
kput 32 999
kput 33 8
kput 34 9
kput 35 10
else
kput 5 3
kput 6 2
kput 7 3
kput 8 3
kput 9 2
kput 10 2
kput 11 9
kput 12 6
kput 13 6
kput 15 302
for i ulong 9
kput add 24 i add i 1
end
for i ulong 6
kput add 33 i add i 1
end
end
end
fn kload id ulong to ulong
note Reject before modifying either caller buffer. Valid loads never touch ko.
if or eq id 0 gt id 8
ret 0
end
kbase id
if le id 6
klinear id
else
kmatrix id
end
ret add 96 mul 4 add kw 11 kw 12
end
