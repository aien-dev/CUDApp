note Stdin is one selector byte 0..5 followed by EOF.
global input uchar 2
text start "#include <metal_stdlib>\nusing namespace metal;\nkernel void k(volatile device const uint *a [[buffer(0)]], volatile device const uint *b [[buffer(1)]], volatile device const uint *c [[buffer(2)]], device uint *out [[buffer(3)]], uint gid [[thread_position_in_grid]]) {\nuint va=a[gid]; uint vb=b[gid]; uint vc=c[gid];\nout[gid] = "
text e0 "va * vb + vc;\n}\n"
text e1 "va * vc + vb;\n}\n"
text e2 "vb * vc + va;\n}\n"
text e3 "va * vb;\n}\n"
text e4 "va + vb + vc;\n}\n"
text e5 "(va | vb) + vc;\n}\n"
