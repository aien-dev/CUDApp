note SPDX-License-Identifier MIT
note Host-native test adapter not a CUDA API or GPU implementation
note Input 40 bytes mode u32 reserved u32 then four little endian u64
note mode 0 raw block counter low counter high key reserved
note mode 1 seed subsequence word offset count up to 65536
note All request validation precedes output
 global inp uchar 41
global out uchar 262144
fn load at ulong to ulong
v = ulong 0
for j ulong 8
v = or v shl ulong get inp add at j mul j 8
end
ret v
end
fn store at ulong v ulong to void
for j ulong 4
put out add at j uchar and shr v mul j 8 255
end
end
fn emit n ulong to int
p = ulong 0
while lt p n
w = write 1 out p sub n p
if le w 0
ret 3
end
p = add p ulong w
end
ret 0
end
fn main to int
n = ulong 0
while lt n 41
r = read 0 inp n sub 41 n
if lt r 0
ret 2
end
if eq r 0
if ne n 40
ret 2
end
n = ulong 41
else
n = add n ulong r
if eq n 41
ret 2
end
end
end
mode = load 0
if gt mode 1
ret 2
end
a = new ulong 4 0
seed = load 8
subseq = load 16
offset = load 24
count = load 32
if eq mode 0
if ne count 0
ret 2
end
put a 0 and seed 4294967295
put a 1 shr seed 32
put a 2 and subseq 4294967295
put a 3 shr subseq 32
philox a and offset 4294967295 shr offset 32
for j ulong 4
store mul j 4 get a j
end
ret emit 16
end
if gt count 65536
ret 2
end
if gt count 0
if gt sub count 1 sub ulong 18446744073709551615 offset
ret 2
end
end
for i ulong count
word = add offset i
block = shr word 2
put a 0 and block 4294967295
put a 1 shr block 32
put a 2 and subseq 4294967295
put a 3 shr subseq 32
philox a and seed 4294967295 shr seed 32
store mul i 4 get a and word 3
end
ret emit mul count 4
end
