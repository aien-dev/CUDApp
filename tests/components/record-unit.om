ret 12
end
put cfg 0 3
for j ulong 5
put cfg add j 1 ru_arg add j 1
end
put out 0 ru_word h 1
put out 1 ru_word h 5
put out 2 ru_word h 6
put out 3 ru_word h 4
put out 4 ru_word h 2
put out 5 ru_word h 3
ret 0
end
fn ru_build cfg view ulong 16 b edit uchar 4096 l edit ulong 32 out edit ulong 8 to int
