note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note MXFP4 E2M1 nibble plus E8M0 block scale to exact IEEE binary32 bits.
note gpt-oss reference: openai/gpt-oss gpt_oss/torch/weights.py FP4_VALUES,
note low nibble precedes high nibble; scales are biased by 127.
note Returns bits so the identical integer unit runs on native and irspirv.
note Scalar primitive, not GEMM or an inference engine. No device access.
note Refuse non-nibbles and reserved E8M0 255 (NaN block) with trap 5.
note Finite overflow produces signed infinity; signed zero is preserved.
note Wolfram: Table[If[m==0,0,If[m==1,2^-1,(1+Mod[m,2]/2)
note 2^(Quotient[m,2]-1)]],{m,0,7}] == {0,1/2,1,3/2,2,3,4,6} -> True.
note Wolfram: {2^23,2^22,2^31} -> {8388608,4194304,2147483648}.
fn mxfp4bits nib uint scale uint to uint
if gt nib 15
trap 5
end
if gt scale 254
trap 5
end
sign = shl and nib 8 28
mag = and nib 7
if eq mag 0
ret sign
end
expo = sub long scale 1
frac = uint 0
if ge mag 2
expo = add expo long shr mag 1
frac = shl and mag 1 22
end
if ge expo 255
ret or sign uint 2139095040
end
if le expo 0
sig = or frac uint 8388608
sig = shr sig uint sub long 1 expo
ret or sign sig
end
ret or sign or shl uint expo 23 frac
end
fn mxfp4byte packed uint lane uint scale uint to uint
if gt packed 255
trap 5
end
if gt lane 1
trap 5
end
nib = and shr packed mul lane 4 15
value = mxfp4bits nib scale
ret value
end
