note Caller owns/pins kt; only ko contains candidate observations. No code execution.
global kt uchar 4096
global ko uchar 1032
fn kw i ulong to ulong
v = ulong 0
for j ulong 4
v = or v shl ulong get kt add mul i 4 j mul j 8
end
ret v
end
fn kc i ulong to ulong
v = ulong 0
for j ulong 4
v = or v shl ulong get ko add mul i 4 j mul j 8
end
ret v
end
fn kshape to ulong
