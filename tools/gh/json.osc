fn json_num_at(b: bytes, off: u64) -> u64 {
    if off >= b.len {
        return 18446744073709551615;
    }
    let mut j: u64 = off;
    let mut v: u64 = 0;
    if b[j] == 45 || b[j] == 46 || b[j] == 101 || b[j] == 69 {
