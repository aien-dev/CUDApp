put sp_tbl 3000 1
end

fn sp_find sp_tbl view ulong 3001 o view ulong 16 to ulong
op = get o 0
for i ulong 63
base = mul i 45
f_op = get sp_tbl base
if eq f_op op
var = get sp_tbl add base 1
if eq op 8
  if ne get o 13 0
    if eq var 0
      ret i
    end
  else
    if and ne get o 8 0 ne get o 14 0
      if eq var 1
        ret i
      end
    else
      if eq var 2
        ret i
      end
    end
  end
else
  if eq op 10
    if and ne get o 8 0 ne get o 14 0
      if eq var 0
        ret i
      end
    else
      if eq var 1
        ret i
      end
    end
  else
    ret i
  end
end
end
end
ret 63
end

fn sp_val role ulong word ulong o view ulong 16 to ulong
if or eq role R_RD eq role R_URD
ret get o 1
end
if or eq role R_RA eq role R_URA
op = get o 0
if and eq role R_RA or eq op 51 or eq op 52 eq op 53
if eq get o 12 0
ret 255
end
end
ret get o 2
end
if eq role R_RB
op = get o 0
if or eq op 51 or eq op 52 eq op 53
if eq get o 13 0
ret 255
end
end
ret get o 3
end
if eq role R_URB
op = get o 0
if or eq op 6 eq op 7
ret get o 1
end
ret get o 5
end
if eq role R_RC
ret get o 4
end
if eq role R_PRED3
if eq word 0
ret get o 1
end
ret get o 4
end
if eq role R_PRED
if eq get o 9 0
ret 7
end
if eq get o 10 0
ret 0
end
ret 8
end
if eq role R_BAR
ret get o 11
end
if eq role R_SHFL
ret get o 6
end
if eq role R_LUT
ret get o 6
end
ret get o 6
end

fn sp_off24 imm ulong to bool
ret or lt imm 8388608 and ge imm 4286578688 le imm 4294967295
end

fn sp_chkr role ulong val ulong min_v ulong max_v ulong to bool
if eq role R_OFF24
ret sp_off24 val
end
if eq role R_BSSY
ret not or lt val 2 ge val 2147483648
end
if eq role R_LDSW
ret lt val 8388608
end
if eq role R_BRA
ret le val 4294967295
end
ret not or lt val min_v lt max_v val
end

fn sp_fput sp_tbl view ulong 3001 fbase ulong val ulong w edit ulong 4 to void
role = get sp_tbl fbase
if eq role R_BRA
rel = and sub val 1 4294967295
put w 0 or get w 0 shl and rel 63 18
s = shr rel 6
c = ulong 58720256
if ge rel 2147483648
s = or s 4227858432
c = 58982399
end
put w 1 or get w 1 and shl s 2 4294967295
put w 2 c
ret
end
if eq role R_BSSY
put w 1 or get w 1 and mul sub val 1 16 4294967295
ret
end
if eq role R_LDC
shift = get sp_tbl add fbase 2
put w 1 or get w 1 and shl val shift 16776960
ret
end
if or eq role R_LDSW eq role R_OFF24
put w 1 or get w 1 shl and val 16777215 8
ret
end
if eq role R_FSET
if ne val 0
put w 2 val
else
put w 2 66084864
end
ret
end
word = get sp_tbl add fbase 1
shift = get sp_tbl add fbase 2
width = get sp_tbl add fbase 3
mask = sub shl 1 width 1
val_m = and val mask
cur_w = get w word
put w word or cur_w shl val_m shift
end

fn sp_fenc sp_tbl view ulong 3001 fbase ulong o view ulong 16 w edit ulong 4 to ulong
role = get sp_tbl fbase
word = get sp_tbl add fbase 1
min_v = get sp_tbl add fbase 5
max_v = get sp_tbl add fbase 6
val = sp_val role word o
ok = sp_chkr role val min_v max_v
if not ok
ret E_RANGE
end
sp_fput sp_tbl fbase val w
note Reject values whose special bit layout would discard semantic bits.
probe = new ulong 16 0
special = sp_dimm sp_tbl role fbase w probe
if special
if eq role R_FSET
if eq val 0
ret E_OK
end
end
if ne get probe 6 val
ret E_RANGE
end
end
ret E_OK
end

fn sp_enc sp_tbl edit ulong 3001 o view ulong 16 w edit ulong 4 to ulong
sp_init sp_tbl
idx = sp_find sp_tbl o
if eq idx 63
ret E_UNSUP
end
base = mul idx 45
put w 0 get sp_tbl add base 2
put w 1 get sp_tbl add base 4
put w 2 get sp_tbl add base 6
sp_ctl = get o 7
if ne sp_ctl 0
put w 3 sp_ctl
else
put w 3 get sp_tbl add base 8
end
nf = get sp_tbl add base 9
for f_i ulong nf
fbase = add add base 10 mul f_i 7
st = sp_fenc sp_tbl fbase o w
if ne st E_OK
ret st
end
end
if eq get sp_tbl base 46
if eq get o 7 0
val = get o 6
if and eq val 0 eq get o 9 0
put w 3 1032192
else
put w 3 1042944
end
end
end
ret E_OK
end

fn sp_dfnd sp_tbl view ulong 3001 w view ulong 4 to ulong
for i ulong 63
base = mul i 45
w0_fix = get sp_tbl add base 2
w0_mask = get sp_tbl add base 3
if ne and get w 0 w0_mask w0_fix
continue
end
w1_fix = get sp_tbl add base 4
w1_mask = get sp_tbl add base 5
if ne and get w 1 w1_mask w1_fix
continue
end
w2_fix = get sp_tbl add base 6
w2_mask = get sp_tbl add base 7
if ne and get w 2 w2_mask w2_fix
continue
end
ret i
end
ret 63
end

note Isolate branch extraction to keep the seeded function-mode register budget bounded.
fn sp_brad w view ulong 4 o edit ulong 16 to void
low6 = and shr get w 0 18 63
hi = and shr get w 1 2 67108863
if or eq get w 2 58982399 ne and get w 1 2147483648 0
if ne and hi 33554432 0
hi = or hi 4227858432
end
end
rel = or shl hi 6 low6
put o 6 and add rel 1 4294967295
end

fn sp_dimm sp_tbl view ulong 3001 role ulong fbase ulong w view ulong 4 o edit ulong 16 to bool
if eq role R_BRA
sp_brad w o
ret true
end
if eq role R_BSSY
put o 6 add div get w 1 16 1
ret true
end
if eq role R_LDC
shift = get sp_tbl add fbase 2
put o 6 shr and get w 1 16776960 shift
ret true
end
if or eq role R_LDSW eq role R_OFF24
raw = and shr get w 1 8 16777215
if and eq role R_OFF24 ge raw 8388608
raw = or raw 4278190080
end
put o 6 raw
ret true
end
if eq role R_FSET
put o 6 get w 2
ret true
end
ret false
end

fn sp_fdec sp_tbl view ulong 3001 fbase ulong w view ulong 4 o edit ulong 16 to void
role = get sp_tbl fbase
is_imm = sp_dimm sp_tbl role fbase w o
if is_imm
ret
end
word = get sp_tbl add fbase 1
shift = get sp_tbl add fbase 2
width = get sp_tbl add fbase 3
mask = sub shl 1 width 1
raw = and shr get w word shift mask
if or eq role R_RD eq role R_URD
put o 1 raw
put o 8 1
ret
end
if or eq role R_RA eq role R_URA
put o 2 raw
put o 12 1
ret
end
if or eq role R_RB eq role R_URB
if eq role R_URB
op = get o 0
if or eq op 6 eq op 7
put o 1 raw
ret
end
put o 5 raw
put o 14 1
else
put o 3 raw
put o 13 1
end
ret
end
if eq role R_RC
put o 4 raw
ret
end
if eq role R_PRED3
if eq word 0
put o 1 raw
put o 8 1
else
put o 4 raw
end
ret
end
if eq role R_PRED
if eq raw 0
put o 9 1
put o 10 0
else
if eq raw 8
put o 9 1
put o 10 1
else
put o 9 0
put o 10 0
end
end
ret
end
if eq role R_BAR
put o 11 raw
ret
end
put o 6 raw
end

fn sp_dec sp_tbl edit ulong 3001 w view ulong 4 o edit ulong 16 to ulong
sp_init sp_tbl
idx = sp_dfnd sp_tbl w
if eq idx 63
ret E_NOMAT
end
for k ulong 16
put o k 0
end
base = mul idx 45
put o 0 get sp_tbl base
put o 7 get w 3
nf = get sp_tbl add base 9
for f_i ulong nf
fbase = add add base 10 mul f_i 7
sp_fdec sp_tbl fbase w o
end
ret E_OK
end


