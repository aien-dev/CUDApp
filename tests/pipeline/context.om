note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Synthetic private graph contexts; no evaluator or hardware qualification.
fn main to int
keys = new ulong 128 0
actual = new ulong 4 0
if ne native_context keys 0 actual 0
ret 1
end
put actual 0 99
if ne native_context keys 33 actual -1
ret 2
end
if ne native_context keys 18446744073709551615 actual -1
ret 3
end
put actual 0 1
put actual 1 3
put actual 3 8
for i ulong 32
put keys mul i 4 1
put keys add mul i 4 1 3
put keys add mul i 4 2 i
put keys add mul i 4 3 8
end
for i ulong 32
put actual 2 i
if ne native_context keys 32 actual long add i 1
ret 4
end
end
note No active context, or an excluded late context, is not a default binding.
put actual 2 31
if ne native_context keys 0 actual 0
ret 5
end
if ne native_context keys 31 actual 0
ret 6
end
note Every tuple field participates: operation,layer,window start,window rows.
put actual 2 0
for j ulong 4
old = get actual j
put actual j 123
if ne native_context keys 32 actual 0
ret 7
end
put actual j old
end
note Duplicate matches refuse rather than silently choosing first or last.
for j ulong 4
put keys add 124 j get keys j
end
if ne native_context keys 32 actual -1
ret 8
end
note Unrelated duplicate registrations cannot change a different exact context.
put actual 2 2
if ne native_context keys 32 actual 3
ret 9
end
put actual 2 123
if ne native_context keys 32 actual 0
ret 10
end
note Context ordinals intentionally track immutable registry order, not a tuner.
put actual 2 0
if ne native_context keys 1 actual 1
ret 11
end
note Raw tuple lookup does not claim an operation kind is supported or qualified.
put keys 0 0
put actual 0 0
if ne native_context keys 1 actual 1
ret 12
end
ret 0
end
