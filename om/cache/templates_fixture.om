fn main to int
hashes = new uchar 4096 0
for i ulong 96
put hashes i kt_byte get kt_hash mul i 2 get kt_hash add mul i 2 1
end
l = new ulong 32 0
wire = new uchar 4096 0
put l 0 1
put l 1 1
