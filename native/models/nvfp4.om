note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note NVFP4: E2M1 elements (OCP MX v1.0 FP4, values 0 .5 1 1.5 2 3 4 6) with one
note unsigned E4M3 (UE4M3, sign bit zero) scale per 16 elements. Needs fp8.om
note (f32norm, e4m3enc) in the same unit. Integer bits except nvfp4scale.
note Packing: element 2i is the low nibble of byte i, element 2i+1 the high.
note Scale codes 0..126 are accepted; 127 (NaN) and 128..255 (sign set) trap 5.
note A product of E2M1 (2 significant bits) and UE4M3 (4) is exact in binary32:
note Wolfram: {6 448, 2^-1 2^-9} -> {2688, 1/1024}, both inside binary32 normals.
note Encode nvfp4enc x scale: nearest even E2M1 value to x/scale, by comparing
note |x| with scale times the midpoints {1,3,5,7,10,14,20}/4 (exact binary32,
note Wolfram: 15 20 < 2^24). Above 6 and Inf saturate to 6; NaN traps 5;
note scale 0 gives signed zero.
note nvfp4scale amax: e4m3enc of the binary32 quotient amax/6 with saturation
note (the per-block scale of the NVIDIA FP32 recipe; no per-tensor scale here).
fn e2m1x2 m uint to uint
if lt m 4
ret m
end
ret shl add uint 2 and m 1 sub shr m 1 1
end
fn ue4m3sig scale uint to uint
if gt scale 126
trap 5
end
se = shr scale 3
if eq se 0
ret and scale 7
end
ret or and scale 7 8
end
fn ue4m3exp scale uint to long
se = shr scale 3
if eq se 0
ret -9
end
ret sub long se 10
end
fn nvfp4bits nib uint scale uint to uint
if gt nib 15
trap 5
end
si = ue4m3sig scale
s = shl and nib 8 28
v = e2m1x2 and nib 7
if eq v 0
ret s
end
if eq si 0
ret s
end
ret or s f32norm mul v si sub ue4m3exp scale 1
end
fn nvfp4mid k uint to uint
if eq k 0
ret 1
end
if eq k 1
ret 3
end
if eq k 2
ret 5
end
if eq k 3
ret 7
end
if eq k 4
ret 10
end
if eq k 5
ret 14
end
ret 20
end
fn nvfp4enc bits uint scale uint to uint
si = ue4m3sig scale
s = and shr bits 28 8
a = and bits 2147483647
if gt a 2139095040
trap 5
end
if eq si 0
ret s
end
u = sub ue4m3exp scale 2
c = uint 0
for k uint 7
t = f32norm mul si nvfp4mid k u
if lt a t
break
end
if gt a t
c = add k 1
continue
end
if eq and k 1 1
c = add k 1
end
break
end
ret or s c
end
fn nvfp4scale amax uint to uint
if gt amax 2139095040
trap 5
end
q = div bitcast f32 amax 6.0f32
ret e4m3enc bitcast uint q 1
end
fn nvfp4nib x view uint 16 q edit uchar 8 to uint
amax = uint 0
for i ulong 16
a = and get x i 2147483647
if gt a 2139095040
trap 5
end
if gt a amax
amax = a
end
end
sc = nvfp4scale amax
for j ulong 8
lo = nvfp4enc get x mul j 2 sc
hi = nvfp4enc get x add mul j 2 1 sc
put q j uchar or lo shl hi 4
end
ret sc
end
