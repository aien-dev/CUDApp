if eq m 2
if eq n 3
if eq k 2
ret 301
end
end
end
if eq m 3
if eq n 2
if eq k 3
ret 302
end
end
end
ret 0
end
if ne n 1
ret 0
end
if ne k 1
ret 0
end
base = mul op 100
if eq m 3
ret add base 1
end
if eq m 8
ret add base 2
end
if eq m 17
ret add base 3
end
ret 0
end
fn kextent rows ulong cols ulong stride ulong to ulong
ret add mul sub rows 1 stride cols
end
fn kstrides to int
