text RUOk "PASS staged canonical/launch/cfg/out8 controls and independent C statistics\n"
fn ru_word h view uchar 56 k ulong to ulong
v = ulong 0
for j ulong 8
v = or v shl ulong get h add mul k 8 j mul j 8
end
ret v
end
fn ru_arg k ulong to ulong
a = new uchar 8 0
n = argread k a 0 8
if or le n 0 gt n 5
ret 0
end
v = ulong 0
for j ulong ulong n
c = get a j
if or lt c 48 gt c 57
ret 0
end
v = add mul v 10 sub ulong c 48
end
if gt v 16384
ret 0
end
ret v
end
fn ru_bad b edit uchar 4096 field ulong value ulong to bool
old = compose_word b field
compose_put b field value
rc = compose_check b 1152
compose_put b field old
ret ne rc 0
end
fn ru_input cfg edit ulong 16 out edit ulong 8 to int
h = new uchar 56 0
pos = ulong 0
while lt pos 56 bound 56
n = read 0 h pos sub ulong 56 pos
if le n 0
ret 11
