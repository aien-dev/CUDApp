note Native end-to-end laboratory qualification. Independent Wolfram literal fixtures.
global counts ulong 2
global decbuf uchar 32
global backup uchar 4096
fn number v ulong to void
n = ulong 0
again = true
while again
put decbuf n uchar add rem v 10 48
v = div v 10
n = add n 1
again = ne v 0
end
for i ulong n
rc = write 1 decbuf sub sub n i 1 1
end
put decbuf 0 10
rc = write 1 decbuf 0 1
end
fn check ok bool id ulong to void
put counts 0 add get counts 0 1
if not ok
put counts 1 add get counts 1 1
number id
end
end
fn make target ulong depth ulong to bool
if eq target 1
ret amd_generate depth
end
ret agx_generate depth
end
fn run target ulong rows ulong depth ulong to int
if eq target 1
ret amd_run rows depth
end
ret agx_run rows depth
end
fn signed v ulong to ulong
if ge v 128
ret lowword sub v 256
end
ret v
end
fn poison to void
for r ulong 32
put mem add 3072 r 3735928559
end
end
fn clean to bool
for r ulong 32
if ne get mem add 3072 r 3735928559
ret false
end
end
ret true
end
fn pairs target ulong to void
check make target 1 601
for a ulong 256
for b ulong 256
put mem 0 signed a
put mem 2048 signed b
put mem 3072 3735928559
rc = run target 1 1
check eq rc 0 602
note Independent signed magnitude calculation, not the unsigned simulator ALU.
x = long a
y = long b
if ge a 128
x = sub x 256
end
if ge b 128
y = sub y 256
end
z = mul x y
if lt z 0
z = add z 4294967296
end
check eq get mem 3072 ulong z 603
end
end
end
fn wolfram target ulong to void
check make target 8 610
put mem 0 4294967168
put mem 1 127
put mem 2 4294967295
put mem 3 0
put mem 4 1
put mem 5 17
put mem 6 4294967273
put mem 7 64
put mem 2048 127
put mem 2049 4294967168
put mem 2050 4294967295
put mem 2051 1
put mem 2052 0
put mem 2053 4294967277
put mem 2054 29
put mem 2055 64
check eq run target 1 8 0 611
check eq get mem 3072 4294937891 612
check make target 64 613
for k ulong 64
put mem k 4294967168
put mem add 2048 k 4294967168
end
check eq run target 1 64 0 614
check eq get mem 3072 1048576 615
for k ulong 64
put mem k 127
end
check eq run target 1 64 0 616
check eq get mem 3072 4293926912 617
for k ulong 64
put mem add 2048 k 127
end
check eq run target 1 64 0 618
check eq get mem 3072 1032256 619
end
fn structural target ulong to void
check make target 4 630
n = get used 0
for i ulong n
put backup i get code i
end
for size ulong n
poison
put used 0 size
check ne run target 3 4 0 631
check clean 632
end
put used 0 add n 1
put code n 0
check ne run target 3 4 0 633
check clean 634
put used 0 4097
check ne run target 3 4 0 635
check clean 636
put used 0 n
for i ulong n
put code i get backup i
end
note Fault only on the last lane: prove earlier lanes did not publish.
put state 0 3
put state 1 4
poison
if eq target 1
check amd_lane 0 637
check amd_lane 1 638
else
check agx_lane 0 637
check agx_lane 1 638
end
check clean 639
put code 0 255
check ne run target 3 4 0 640
check clean 641
end
fn requesttests to void
check not build_request 0 4 650
check eq get used 0 0 651
check not build_request 3 4 652
check eq get used 0 0 653
check not build_request 1 0 654
check not build_request 2 65 655
check build_request 1 4 656
check eq word 0 4 2114716288 657
check build_request 2 4 658
check eq word 0 6 6498 659
end
fn main to int
requesttests
for t ulong 2
target = add t 1
pairs target
wolfram target
structural target
end
number get counts 0
number get counts 1
if ne get counts 1 0
ret 1
end
ret 0
end
