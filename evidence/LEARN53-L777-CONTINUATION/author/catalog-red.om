note SPDX-License-Identifier: AGPL-3.0-only
note Public fixtures, never sealed evaluation. Expected literals independently checked with Wolfram.
text okmsg "PASS "
text badmsg "FAIL "
global nums uchar 32
global tally ulong 2
global saved uchar 4096
fn digit n ulong to void
if ge n 10
digit div n 10
end
put nums 0 uchar add 48 rem n 10
w = write 1 nums 0 1
end
fn check yes bool to void
put tally 0 add get tally 0 1
if yes
w = write 1 okmsg 0 len okmsg
else
w = write 1 badmsg 0 len badmsg
put tally 1 add get tally 1 1
end
digit get tally 0
put nums 0 10
w = write 1 nums 0 1
end
fn tw p ulong v ulong to void
for i ulong 4
put kt add mul p 4 i uchar and shr v mul i 8 255
end
end
fn cw p ulong v ulong to void
for i ulong 4
put ko add mul p 4 i uchar and shr v mul i 8 255
end
end
