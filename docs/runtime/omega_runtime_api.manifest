# ---- general matrix multiply (src/omega_gpu_gemm_ex.h, added in 0.6.0; EXPERIMENTAL: one chip, migration-pending C) ----
struct OmegaGemmExInfo 24 8 # EXPERIMENTAL
field OmegaGemmExInfo route 0 4 u32 1
field OmegaGemmExInfo core_type 4 4 u32 1
field OmegaGemmExInfo core_calls 8 8 u64 1
field OmegaGemmExInfo host_fixed 16 8 u64 1
struct OmegaGemmExArgs 200 8 # EXPERIMENTAL
field OmegaGemmExArgs op_a 0 4 enum 1
field OmegaGemmExArgs op_b 4 4 enum 1
field OmegaGemmExArgs m 8 8 u64 1
field OmegaGemmExArgs n 16 8 u64 1
field OmegaGemmExArgs k 24 8 u64 1
field OmegaGemmExArgs batch 32 8 u64 1
field OmegaGemmExArgs a_type 40 4 enum 1
field OmegaGemmExArgs b_type 44 4 enum 1
field OmegaGemmExArgs c_type 48 4 enum 1
field OmegaGemmExArgs a 56 8 ptr 1
field OmegaGemmExArgs lda 64 8 u64 1
field OmegaGemmExArgs stride_a 72 8 u64 1
field OmegaGemmExArgs b 80 8 ptr 1
field OmegaGemmExArgs ldb 88 8 u64 1
field OmegaGemmExArgs stride_b 96 8 u64 1
field OmegaGemmExArgs c 104 8 ptr 1
field OmegaGemmExArgs ldc 112 8 u64 1
field OmegaGemmExArgs stride_c 120 8 u64 1
field OmegaGemmExArgs alpha 128 4 f32 1
field OmegaGemmExArgs beta 132 4 f32 1
