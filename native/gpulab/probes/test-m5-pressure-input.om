note Independent exact source golden for pressure one.
global probe uchar 2048
text golden "#include <metal_stdlib>\nusing namespace metal;\nkernel void k(volatile device const uint *a [[buffer(0)]], volatile device const uint *b [[buffer(1)]], volatile device const uint *c [[buffer(2)]], device uint *out [[buffer(3)]], uint gid [[thread_position_in_grid]]) {\nuint va=a[gid]; uint vb=b[gid]; uint vc=c[gid];\nuint v0=a[gid+1];\nout[gid] = va * vb + vc;\nout[gid+1] = va; out[gid+2] = vb; out[gid+3] = vc;\nout[gid+4] = v0;\n}\n"
fn main to int
size = ulong 0
for i ulong 2048
n = read 0 probe size 1
if lt n 0
ret 74
end
if eq n 0
if ne size len golden
ret 1
end
for j ulong len golden
if ne get probe j get golden j
ret 2
end
end
ret 0
end
size = add size 1
end
ret 65
end
