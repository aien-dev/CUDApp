else
if lt v 32
put b 0 92
put b 1 117
put b 2 48
put b 3 48
hi = div ulong v 16
lo = rem ulong v 16
put b 4 uchar add hi 48
if ge hi 10
put b 4 uchar add hi 87
end
put b 5 uchar add lo 48
if ge lo 10
put b 5 uchar add lo 87
end
rc_text b 6
else
put b 0 v
rc_text b 1
end
end
end
