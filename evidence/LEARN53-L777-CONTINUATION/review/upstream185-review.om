fn observationtests to void
for i ulong 256
put LWant i uchar and i 255
put LGot i uchar and i 255
end
check lobserve 0 0 0 8 8 0
put LGot 7 99
check lobserve 0 0 0 8 8 7
check lobserve 0 0 0 8 0 9
check lobserve 0 0 0 8 7 7
check lobserve 0 0 0 0 0 10
check lobserve 0 102 102 0 0 0
check lobserve 0 102 103 0 0 8
check lobserve 0 102 102 0 1 8
check lobserve 0 9 9 0 0 10
check lobserve 0 0 102 8 0 8
check lobserve 0 0 0 257 257 10
for i ulong 6
check lobserve add i 1 0 0 8 8 add i 1
end
check lobserve 7 0 0 8 8 10
end

