fn main to int
load3
code = potrf 3
if ne code 0
ret code
end
if ne chk get pl 0 1073741824 0
ret 11
end
if ne chk get pl 3 1086324736 0
ret 12
end
if ne chk get pl 4 1065353216 0
ret 13
end
if ne chk get pl 6 3238002688 0
ret 14
end
if ne chk get pl 7 1084227584 0
