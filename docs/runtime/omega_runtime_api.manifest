# Omega Runtime API manifest: the canonical list of the C entries that docs/runtime/API.md describes.
# Canonical from R1 (2026-10-19): Omega's copy leads; aien-sovereign-core's crates/aien-omega-gpu/abi/omega_gpu.manifest
# must match it (R12 checks that). The part from "libraries" down to the end of the `fn` lines of those headers was
# copied from that file at aien-sovereign-core origin/main (see the "carried over" comment below) and kept unchanged.
# Line format = aien-abi-conformance src/manifest.rs (header, struct, field, const, fn); `#` starts a comment.
# Additions to that format, all inside comments or in the free `kind` column, so its parser still reads the file:
#   - every `struct` and `fn` line ends with a tier comment: `# STABLE` or `# EXPERIMENTAL` (INTERNAL entries are not listed);
#   - field kinds beyond its list: `ptr` (any pointer, 8 bytes), `enum` (4 bytes), `struct:Name` (a struct by value);
#     `usize`/size_t fields are written `u64` (LP64), as it does.
# Checked by tools/runtime_api_check.sh (make test-runtime-api): every `fn` against its header with the exact types,
# every size, offset and constant against a compiled probe, the version macros against src/omega_runtime_api.h.
# After a deliberate header change: edit the line here, run `tools/runtime_api_check.sh --bless` to refresh numbers, review the diff.
abi omega_runtime 0.1
header src/omega_runtime_api.h
header src/omega_gpu_platform.h
header src/omega_gpu_session.h
header src/omega_gpu_mem_cached.h
header src/omega_gpu_cmdlist.h
header src/omega_gpu_engine.h
header src/omega_gpu_matmul_api.h
header src/omega_gpu_serving.h
header src/omega_gpu_elementwise_api.h
header src/omega_gpu_attention_api.h
# ---- version ----
const OMEGA_RUNTIME_API_VERSION_MAJOR 0
const OMEGA_RUNTIME_API_VERSION_MINOR 1
