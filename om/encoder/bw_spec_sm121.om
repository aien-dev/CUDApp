note bw_spec_sm121.om: authoritative specification-driven sm_121 instruction encoder and decoder.
note Follows Drake's essay direction: Meaning -> Realization -> Encoding.
note Single table: 63 instruction forms (covering all 60 opcodes of BlackwellIROpcode),
note with bit offset, width, signedness, min, max, fixed bits and mask for each word.
note From this single specification, both sp_enc (encoder) and sp_dec (decoder) are implemented.

const E_OK ulong 0
const E_UNSUP ulong 1
const E_RANGE ulong 2
const E_NOMAT ulong 3

const R_NONE ulong 0
const R_RD ulong 1
const R_RA ulong 2
const R_RB ulong 3
const R_RC ulong 4
const R_URD ulong 5
const R_URA ulong 6
const R_URB ulong 7
const R_PRED ulong 8
const R_IMM32 ulong 9
const R_OFF24 ulong 10
const R_IMM16 ulong 11
const R_BAR ulong 12
const R_BSSY ulong 13
const R_BRA ulong 14
const R_LDC ulong 15
const R_SHFL ulong 16
const R_LUT ulong 17
const R_S2R ulong 18
const R_LDSW ulong 19
const R_FSET ulong 20
const R_PRED3 ulong 21

note Caller-owned state: slots 0..2999 table, slot 3000 initialized last.
note Allocate zero-filled state per owner; never accept serialized or shared mutable state.

fn set_hdr sp_tbl edit ulong 3001 idx ulong op ulong var ulong w3_def ulong nf ulong to void
base = mul idx 45
put sp_tbl base op
put sp_tbl add base 1 var
put sp_tbl add base 8 w3_def
put sp_tbl add base 9 nf
end

fn set_w0 sp_tbl edit ulong 3001 idx ulong fix ulong mask ulong to void
base = mul idx 45
put sp_tbl add base 2 fix
put sp_tbl add base 3 mask
end

fn set_w1 sp_tbl edit ulong 3001 idx ulong fix ulong mask ulong to void
base = mul idx 45
put sp_tbl add base 4 fix
put sp_tbl add base 5 mask
end

fn set_w2 sp_tbl edit ulong 3001 idx ulong fix ulong mask ulong to void
base = mul idx 45
put sp_tbl add base 6 fix
put sp_tbl add base 7 mask
end

fn set_fld sp_tbl edit ulong 3001 idx ulong f_idx ulong role ulong word ulong shift ulong to void
fbase = add add mul idx 45 10 mul f_idx 7
put sp_tbl fbase role
put sp_tbl add fbase 1 word
put sp_tbl add fbase 2 shift
end

fn set_bnd sp_tbl edit ulong 3001 idx ulong f_idx ulong width ulong is_s ulong min_v ulong to void
fbase = add add mul idx 45 10 mul f_idx 7
put sp_tbl add fbase 3 width
put sp_tbl add fbase 4 is_s
put sp_tbl add fbase 5 min_v
end

fn set_max sp_tbl edit ulong 3001 idx ulong f_idx ulong max_v ulong to void
fbase = add add mul idx 45 10 mul f_idx 7
put sp_tbl add fbase 6 max_v
end

