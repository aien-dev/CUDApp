fn sample r ulong n ulong to void
for i ulong 16
put cobs i 0
end
put cobs 0 r
put cobs 1 n
put cobs 2 1
put cobs 5 add 100 n
put cobs 8 1
put cobs 10 add 106 n
put cobs 11 add 100 mul r 10
put cobs 12 add slen r 1
put cobs 13 7
put cobs 14 1
put cobs 15 63
end
fn collect to void
fixture
check eq cstart 0
check eq cseal 75
for r ulong 7
for i ulong 5
sample r i
check eq cadd 0
end
end
check eq cseal 0
check eq scost 0 108
check eq get srows 4 102
check eq get srows 6 5
check eq get crange 0 106
check eq get crange 1 110
check eq get craw 74 110
check eq get srows 10 5
check eq get srows 75 160
check eq svalid 0
check eq sbegin 0 0
put scontrol 0 0
put scontrol 1 0
check eq sselect 1000 256 1000 7 2 0 0
check eq get decision 3 108
scancel
end
