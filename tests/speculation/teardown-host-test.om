note SPDX-License-Identifier: AGPL-3.0-only
note Synthetic host refusal fixture. The private unit replaces device calls, close and mapdrop.
note No GPU file is opened and no kernel, model, or hardware result is claimed.
global tchecks ulong 1
global tblocked uchar 4
global tlive uchar 4
global tdrops ulong 4
global tmapmode uchar 1
global tmapcloses ulong 1
global tmapopens ulong 1
global tcloses ulong 2
global tdrivercalls ulong 1
global tdriverfail uchar 1
global tclosefail uchar 1
text tok "NATIVE_TEARDOWN_HOST_PASS\n"
text tbad "NATIVE_TEARDOWN_HOST_FAIL\n"
fn tcheck yes bool to void
put tchecks 0 add get tchecks 0 1
if not yes
r = write 2 tbad 0 len tbad
exit int 1
end
end
fn tunexpected to long
if ne get tmapmode 0 0
put tmapopens 0 add get tmapopens 0 1
ret 42
end
tcheck false
ret neg long 5
end
fn tmapnew fd int offset ulong size ulong access int mode int to long
tcheck eq get tmapmode 0 1
tcheck eq fd 42
tcheck eq offset 0
tcheck eq size 4096
tcheck eq access 3
tcheck eq mode 1
put tlive 3 1
ret 14
end
fn tdriver to long
note A retry after descriptor closure must never issue another RM or UVM call.
tcheck eq get nvstate 0 1
put tdrivercalls 0 add get tdrivercalls 0 1
if ne get tdriverfail 0 0
put tdriverfail 0 0
ret neg long 11
end
ret 0
end
fn tdrop m long to long
tcheck and ge m 11 le m 14
i = ulong sub m 11
tcheck eq get tlive i 1
put tdrops i add get tdrops i 1
if ne get tblocked i 0
ret neg long 11
end
put tlive i 0
ret 0
end
fn tclose fd int to long
if eq fd 42
put tmapcloses 0 add get tmapcloses 0 1
tcheck eq get tmapcloses 0 1
ret neg long 5
end
tcheck and ge fd 40 le fd 41
i = ulong sub fd 40
put tcloses i add get tcloses i 1
note A descriptor number could be reused after the first close, even if close reports an error.
tcheck eq get tcloses i 1
if and eq i 0 ne get tclosefail 0 0
ret neg long 5
end
ret 0
end
fn tprepare to void
for i ulong len nvfd
put nvfd i neg int 1
end
put nvfd 0 40
put nvfd 1 41
for i ulong len nvobj
put nvobj i 0
end
for i ulong len nvreg
put nvreg i 0
end
for i ulong len nvmflag
put nvmflag i 0
put nvmobj i 0
put nvmmap i 0
put nvmaddr i 0
put nvmlen i 0
end
for i ulong 3
put tblocked i 0
put tlive i 1
put tdrops i 0
end
for i ulong 2
put tcloses i 0
end
put tdrivercalls 0 0
put tdriverfail 0 0
put tclosefail 0 0
put nverr 0 0
put nvfault 0 0
put nvstate 0 1
put nvchreg 0 0
put nvsched 0 1
put nvbar 0 11
put nvchva 0 12
put nvfifo 0 0
put nvnotify 0 0
put nvput 0 0
put nvret 0 0
put nvmflag 0 2
put nvmmap 0 13
put nvmaddr 0 4096
put nvmlen 0 4096
end
fn tclosed to void
tcheck eq get nvstate 0 0
tcheck eq get nvsched 0 0
tcheck eq get nvbar 0 0
tcheck eq get nvchva 0 0
for i ulong len nvfd
tcheck eq get nvfd i neg int 1
end
for i ulong 2
tcheck eq get tcloses i 1
end
for i ulong 3
tcheck eq get tlive i 0
end
for i ulong len nvmflag
tcheck eq get nvmflag i 0
tcheck eq get nvmobj i 0
tcheck eq get nvmmap i 0
tcheck eq get nvmaddr i 0
tcheck eq get nvmlen i 0
end
for i ulong len nvobj
tcheck eq get nvobj i 0
end
end
fn tretained which ulong to void
if eq which 0
tcheck eq get nvbar 0 11
end
if eq which 1
tcheck eq get nvchva 0 12
end
if eq which 2
tcheck eq get nvmflag 0 2
tcheck eq get nvmmap 0 13
tcheck eq get nvmaddr 0 4096
tcheck eq get nvmlen 0 4096
end
tcheck eq get tlive which 1
tcheck eq get nvstate 0 2
tcheck eq get nvfault 0 1
tcheck eq get nvsched 0 0
for i ulong len nvfd
tcheck eq get nvfd i neg int 1
end
end
fn tretry which ulong driver_refusal bool to void
tprepare
put tblocked which 1
if driver_refusal
note Refuse channel destruction before its handles retire; retry must not free them through closed fds.
put nvobj 6 101
put nvobj 8 102
put nvobj 9 103
put tdriverfail 0 1
end
tcheck not nvstop
tretained which
before = get tdrivercalls 0
tcheck not nvstop
tretained which
tcheck eq get tdrivercalls 0 before
for i ulong 2
tcheck eq get tcloses i 1
end
put tblocked which 0
tcheck nvstop
tclosed
tcheck eq get tdrivercalls 0 before
tcheck eq get nvfault 0 1
tcheck not nvstart
tcheck eq get nverr 0 neg long 5
count = get tdrops which
tcheck nvstop
tcheck eq get tdrops which count
tclosed
end
fn tphaseguard to void
note Force cleanup cannot retire live driver ownership before descriptors close.
tprepare
put nvmflag 0 15
put nvmobj 0 201
tcheck not nvmforce
tcheck eq get nverr 0 neg long 16
tcheck eq get nvstate 0 1
tcheck eq get nvfault 0 0
tcheck eq get nvmflag 0 15
tcheck eq get nvmobj 0 201
tcheck eq get nvmmap 0 13
tcheck eq get nvmaddr 0 4096
tcheck eq get nvmlen 0 4096
for i ulong 3
tcheck eq get tdrops i 0
tcheck eq get tlive i 1
end
for i ulong 2
tcheck eq get tcloses i 0
end
tcheck eq get tdrivercalls 0 0
tcheck nvstop
tclosed
end
fn tunpublished to void
note Close fails after mapping succeeds; a refused unmap must remain reachable.
tprepare
put tmapmode 0 1
put tmapopens 0 0
put tmapcloses 0 0
put tblocked 3 1
put tdrops 3 0
put tlive 3 0
tcheck eq nvcpumap 201 4096 false 0 neg long 1
tcheck eq get tmapopens 0 1
tcheck eq get tmapcloses 0 1
tcheck eq get tlive 3 1
tcheck eq get tdrops 3 1
tcheck eq get nvfault 0 1
tcheck not nvstop
tcheck eq get nvstate 0 2
tcheck eq get tlive 3 1
note A faulted caller cannot overwrite the quarantined handle or reopen a descriptor.
tcheck eq nvcpumap 202 4096 false 0 neg long 1
tcheck eq get tmapopens 0 1
before = get tdrivercalls 0
tcheck not nvstop
tcheck eq get tdrivercalls 0 before
tcheck eq get tmapcloses 0 1
put tblocked 3 0
tcheck nvstop
tclosed
tcheck eq get tlive 3 0
tcheck eq get nvfault 0 1
count = get tdrops 3
tcheck nvstop
tcheck eq get tdrops 3 count
tcheck not nvstart
put tmapmode 0 0
end
fn main to int
note Closed contexts stay idempotent without touching descriptors or mappings.
tcheck nvstop
tprepare
tcheck nvstop
tclosed
tcheck eq get nvfault 0 0
for i ulong 3
tcheck eq get tdrops i 1
end
tcheck nvstop
tclosed
tretry 0 false
tretry 1 false
tretry 2 false
tretry 1 true
tphaseguard
note An error from the descriptor close must latch the fault without retrying that descriptor.
tprepare
put tclosefail 0 1
tcheck not nvstop
tclosed
tcheck eq get nvfault 0 1
tcheck nvstop
tclosed
tcheck not nvstart
tunpublished
tcheck eq write 1 tok 0 len tok long len tok
ret 0
end
