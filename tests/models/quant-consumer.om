note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Actual existing mxmm receives canonical packed output without weight expansion.
fn qt_packcompact a edit uchar 4096 sa edit uchar 256 to uint
d = new ulong 48 0
src = new uchar 65536 0
sc = new uchar 1024 0
out = new uchar 65536 0
os = new uchar 1024 0
qt_base d 4 3
put src 0 33
put src 1 3
put sc 0 127
if ne quant_repack d src sc out os 0
ret 1
end
for i ulong 16
put a i get out i
end
put sa 0 get os 0
ret 0
end
fn qt_consumer to uint
a = new uchar 4096 0
b = new uchar 4096 0
sa = new uchar 256 0
sb = new uchar 256 0
c = new f64 256 0.0f64
shape = new ulong 4 0
put shape 0 1
put shape 1 1
put shape 2 1
put shape 3 32
put a 0 33
put a 1 3
put b 0 33
put b 1 3
put sa 0 127
put sb 0 127
mxmm a sa b sb c shape
expected = get c 0
if ne qt_packcompact b sb 0
ret 1
end
mxmm a sa b sb c shape
if ne get c 0 expected
ret 2
end
ret 0
end
