hp_cat Rt00002 len Rt00002
rt_nl
hp_cat Rt00003 len Rt00003
rt_nl
hp_cat Rt00004 len Rt00004
rt_nl
hp_cat Rt00005 len Rt00005
rt_nl
if or ge kind 6 or eq kind 2 eq kind 4
