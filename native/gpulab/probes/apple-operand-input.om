note SPDX-License-Identifier: MIT
note Omega emits MSL solely as input to the independent Apple oracle.
note Never linked or used as the native backend. Binary stdin: K byte, EOF.
global input uchar 2
global digits uchar 24
text start "#include <metal_stdlib>\nusing namespace metal;\nkernel void k(volatile device const int *w [[buffer(0)]], volatile device const int *x [[buffer(1)]], device int *out [[buffer(2)]], uint gid [[thread_position_in_grid]]) {\nuint base = gid * "
text body ";\nint s = 0;\n"
text lhs "s += w[base + "
text middle "] * x["
text tail "];\n"
text finish "out[gid] = s;\n}\n"
fn number value ulong to bool
n = ulong 0
again = true
while again
put digits n uchar add rem value 10 48
value = div value 10
n = add n 1
again = ne value 0
end
for i ulong n
if ne write 1 digits sub sub n i 1 1 1
ret false
end
end
ret true
end
fn main to int
n = read 0 input 0 1
if lt n 0
ret 74
end
if ne n 1
ret 65
end
depth = ulong get input 0
if or eq depth 0 gt depth 64
ret 65
end
n = read 0 input 1 1
if lt n 0
ret 74
end
if ne n 0
ret 65
end
if ne write 1 start 0 len start long len start
ret 74
end
if not number depth
ret 74
end
if ne write 1 body 0 len body long len body
ret 74
end
for i ulong depth
if ne write 1 lhs 0 len lhs long len lhs
ret 74
end
if not number i
ret 74
end
if ne write 1 middle 0 len middle long len middle
ret 74
end
if not number i
ret 74
end
if ne write 1 tail 0 len tail long len tail
ret 74
end
end
if ne write 1 finish 0 len finish long len finish
ret 74
end
ret 0
end
