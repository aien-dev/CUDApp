note SPDX-License-Identifier: MIT
note Compile-only address-immediate sweep, no GPU dispatch.
global input uchar 2
global digits uchar 24
text start "#include <metal_stdlib>\nusing namespace metal;\nkernel void k(volatile device const uint *a [[buffer(0)]], volatile device const uint *b [[buffer(1)]], volatile device const uint *c [[buffer(2)]], device uint *out [[buffer(3)]], uint gid [[thread_position_in_grid]]) {\nuint va=a[gid]; uint vb=b[gid]; uint vc=c[gid];\nuint vi=a[gid+"
text middle "]; uint offset=gid+"
text finish ";\nout[gid] = va * vb + vc;\nout[gid+1] = va; out[gid+2] = vb; out[gid+3] = vc;\nout[gid+4] = vi; out[gid+5] = offset;\n}\n"
fn number value ulong to bool
n = ulong 0
again = true
while again
put digits n uchar add rem value 10 48
value = div value 10
n = add n 1
again = ne value 0
end
for i ulong n
if ne write 1 digits sub sub n i 1 1 1
ret false
end
end
ret true
end
fn main to int
n = read 0 input 0 1
if lt n 0
ret 74
end
if ne n 1
ret 65
end
index = ulong get input 0
if gt index 63
ret 65
end
n = read 0 input 1 1
if lt n 0
ret 74
end
if ne n 0
ret 65
end
if ne write 1 start 0 len start long len start
ret 74
end
if not number index
ret 74
end
if ne write 1 middle 0 len middle long len middle
ret 74
end
if not number index
ret 74
end
if ne write 1 finish 0 len finish long len finish
ret 74
end
ret 0
end
