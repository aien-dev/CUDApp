fn is_ws(c: u64) -> u64 {
    if c == 32 || c == 9 || c == 10 || c == 13 {
        return 1;
    }
    return 0;
}

fn is_hex(c: u64) -> u64 {
    if c >= 48 && c <= 57 {
        return 1;
    }
    if c >= 97 && c <= 102 {
        return 1;
    }
    if c >= 65 && c <= 70 {
        return 1;
    }
    return 0;
}

fn str_end(b: bytes, i: u64) -> u64 {
    let mut j: u64 = i + 1;
    while j < b.len bound 4096 {
        let c: u64 = b[j];
        if c == 92 {
            j = j + 1;
            if j >= b.len {
                return 18446744073709551615;
            }
            let e: u64 = b[j];
            if e == 117 {
                if j + 4 >= b.len {
                    return 18446744073709551615;
                }
                if is_hex(b[j + 1]) == 0 || is_hex(b[j + 2]) == 0 || is_hex(b[j + 3]) == 0 || is_hex(b[j + 4]) == 0 {
                    return 18446744073709551615;
                }
                j = j + 5;
            } else {
                if e != 34 && e != 92 && e != 47 && e != 98 && e != 102 && e != 110 && e != 114 && e != 116 {
                    return 18446744073709551615;
                }
                j = j + 1;
            }
        } else {
            if c == 34 {
                return j + 1;
            }
            j = j + 1;
        }
    }
    return 18446744073709551615;
}

fn num_end(b: bytes, i: u64) -> u64 {
    let mut j: u64 = i;
    if j < b.len && b[j] == 45 {
        j = j + 1;
    }
    if j >= b.len {
        return 18446744073709551615;
    }
    if b[j] == 48 {
        j = j + 1;
    } else {
        if b[j] < 49 || b[j] > 57 {
            return 18446744073709551615;
        }
        while j < b.len && b[j] >= 48 && b[j] <= 57 bound 4096 {
            j = j + 1;
        }
    }
    if j < b.len && b[j] == 46 {
        j = j + 1;
        if j >= b.len || b[j] < 48 || b[j] > 57 {
            return 18446744073709551615;
        }
        while j < b.len && b[j] >= 48 && b[j] <= 57 bound 4096 {
            j = j + 1;
        }
    }
    if j < b.len && (b[j] == 101 || b[j] == 69) {
        j = j + 1;
        if j < b.len && (b[j] == 43 || b[j] == 45) {
