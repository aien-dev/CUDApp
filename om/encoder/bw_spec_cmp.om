note bw_spec_cmp.om: comparison of spec-driven encoder/decoder vs reference encoder

fn read_exact fd int buf edit uchar 128 n ulong to long
got = ulong 0
while lt got n bound 128
r = read fd buf got sub n got
if lt r 0
ret -1
end
if eq r 0
if ne got 0
ret -1
end
ret 0
end
got = add got ulong r
end
ret long got
end

fn unpack_u64 buf view uchar 128 off ulong to ulong
v = ulong 0
for b ulong 8
sh = mul b 8
byte_v = ulong get buf add off b
v = or v shl byte_v sh
end
ret v
end

fn unpack_case buf view uchar 128 o edit ulong 16 to void
for i ulong 16
off = mul i 8
put o i unpack_u64 buf off
end
end

note Compare active semantic roles, not inactive packing slots. Zero control
note and FSET default are documented canonicalizations, absent RA/RB means RZ.
note Keep field-local values out of the seeded comparator's register live range.
fn same_fld sp_tbl view ulong 3001 fb ulong o view ulong 16 dec view ulong 16 to bool
role = get sp_tbl fb
word = get sp_tbl add fb 1
a = sp_val role word o
b = sp_val role word dec
if and eq role R_FSET eq a 0
a = 66084864
end
if ne a b
ret false
end
ret true
end

fn same_sem sp_tbl view ulong 3001 o view ulong 16 dec view ulong 16 to bool
idx = sp_find sp_tbl o
if eq idx 63
ret false
end
if ne sp_find sp_tbl dec idx
ret false
end
if ne get o 0 get dec 0
ret false
end
base = mul idx 45
control = get o 7
if eq control 0
control = get sp_tbl add base 8
if eq get o 0 46
if and eq get o 6 0 eq get o 9 0
control = 1032192
else
control = 1042944
end
end
end
if ne control get dec 7
ret false
end
nf = get sp_tbl add base 9
for f ulong nf
fb = add add base 10 mul f 7
if not same_fld sp_tbl fb o dec
ret false
end
end
ret true
end

fn run_check_loop sp_tbl edit ulong 3001 corrupt bool to int
buf = new uchar 128 0
o = new ulong 16 0
w_ref = new ulong 4 0
w_spec = new ulong 4 0
o_dec = new ulong 16 0
count = ulong 0

while lt count 500 bound 500
r = read_exact int 0 buf 128
if lt r 0
ret 2
end
if eq r 0
break
end
unpack_case buf o
if ne enc1 o w_ref 0
ret 1
end
if ne sp_enc sp_tbl o w_spec 0
ret 1
end
if and corrupt eq count 0
put w_ref 0 xor get w_ref 0 1
end
for k ulong 4
if ne get w_ref k get w_spec k
ret 1
end
end
if ne sp_dec sp_tbl w_spec o_dec 0
ret 1
end
if not same_sem sp_tbl o o_dec
ret 1
end
count = add count 1
end

if ne count 461
ret 1
end
ret 0
end

fn emit_sample sp_tbl edit ulong 3001 s_idx ulong to int
o = new ulong 16 0
w = new ulong 4 0
buf = new uchar 16 0

if eq s_idx 0
note NOP
put o 0 0
end
if eq s_idx 1
note IMAD R0, R1, R2, R3
put o 0 8
put o 1 0
put o 2 1
put o 3 2
put o 4 3
put o 12 1
put o 13 1
end
if eq s_idx 2
note FADD R4, R5, R6
put o 0 30
put o 1 4
put o 2 5
put o 3 6
put o 12 1
put o 13 1
end
if eq s_idx 3
note LDG.E R10, desc[UR5][R12.64]
put o 0 11
put o 1 10
put o 2 12
put o 5 5
put o 12 1
put o 14 1
end
if eq s_idx 4
note BRA 0x100
put o 0 46
put o 6 16
end

st = sp_enc sp_tbl o w
if ne st 0
ret 1
end

for i ulong 4
v = get w i
off = mul i 4
for b ulong 4
sh = mul b 8
put buf add off b uchar and shr v sh 255
end
end

sent = ulong 0
while lt sent 16 bound 16
k = write int 1 buf sent sub 16 sent
if le k 0
ret 1
end
sent = add sent ulong k
end
ret 0
end

fn run_neg_mutant sp_tbl edit ulong 3001 to int
o = new ulong 16 0
w_mut = new ulong 4 0
w_ref = new ulong 4 0
decoded = new ulong 16 0
put o 0 1
put o 1 5
r_ref = enc1 o w_ref
if ne r_ref 0
ret 1
end

note Shift field on form 1 (MOV_RZ): fbase = 55, shift is at 57
orig_sh = get sp_tbl 57
put sp_tbl 57 add orig_sh 1
r_mut = sp_enc sp_tbl o w_mut
put sp_tbl 57 orig_sh

if ne r_mut 0
ret 1
end

same = true
for i ulong 4
if ne get w_mut i get w_ref i
same = false
end
end

if same
ret 1
end
if ne sp_dec sp_tbl w_mut decoded E_OK
ret 1
end
if same_sem sp_tbl o decoded
ret 1
end
ret 0
end

fn run_neg_range sp_tbl edit ulong 3001 to int
o = new ulong 16 0
w = new ulong 4 0
put o 0 1
put o 1 256
st = sp_enc sp_tbl o w
if ne st E_RANGE
ret 1
end
ret 0
end

fn run_neg_nomat sp_tbl edit ulong 3001 to int
w = new ulong 4 4294967295
dec = new ulong 16 0
dst = sp_dec sp_tbl w dec
if ne dst E_NOMAT
ret 1
end
ret 0
end

fn main to int
sp_tbl = new ulong 3001 0
sp_init sp_tbl
mode = new uchar 16 0
k = ulong 0
if ge argcnt 2
read_k = argread 1 mode 0 16
if gt read_k 0
k = ulong read_k
end
end

if eq k 0
ret run_check_loop sp_tbl false
end

c0 = get mode 0

if eq c0 99
note 'c' -> corrupt
ret run_check_loop sp_tbl true
end

if eq c0 115
note 's' -> sample
s_idx = sub ulong get mode 6 48
ret emit_sample sp_tbl s_idx
end

if eq c0 109
note 'm' -> mutant
ret run_neg_mutant sp_tbl
end

if eq c0 114
note 'r' -> range
ret run_neg_range sp_tbl
end

if eq c0 110
note 'n' -> nomat
ret run_neg_nomat sp_tbl
end

ret 1
end
