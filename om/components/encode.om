note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Concatenate the repaired function-mode encoder and checked spec unchanged before this adapter.
note One instruction representation; emit only words returned by the checked sp_enc.
note The component layout (8192 ulongs = 1024 instructions, phys 0..255 + uvreg 256..287) is copied into the
note encoder's (16384 ulongs = 2048 instructions, phys 0..511 + uvreg 512..543) so both share one opnds.
fn bc_widen ins view ulong 8192 phys view ulong 288 n ulong wide edit ulong 16384 wphys edit ulong 544 to void
for k ulong mul n 8
put wide k get ins k
end
for k ulong 256
put wphys k get phys k
end
for k ulong 32
put wphys add 512 k get phys add 256 k
end
end
fn bc_encode_wide ins view ulong 16384 phys view ulong 544 n ulong pad ulong code edit uchar 32768 to ulong
state = new ulong 3001 0
o = new ulong 16 0
w = new ulong 4 0
cnt = n
if ne pad 0
cnt = mul div add n 7 8 8
if lt cnt 32
cnt = 32
end
end
for i ulong n
opnds ins i phys o
if ne sp_enc state o w 0
ret 0
end
store code i w
end
if gt cnt n
note BW_IR_NOP is opcode0; padding is encoded semantically, never pasted machine bytes.
for j ulong 16
put o j 0
end
if ne sp_enc state o w 0
ret 0
end
for j ulong sub cnt n
store code add n j w
end
end
ret mul cnt 16
end
fn bc_encode ins view ulong 8192 phys view ulong 288 n ulong pad ulong code edit uchar 16384 to ulong
if or eq n 0 gt n 1024
ret 0
end
wide = new ulong 16384 0
wphys = new ulong 544 0
wcode = new uchar 32768 0
bc_widen ins phys n wide wphys
bytes = bc_encode_wide wide wphys n pad wcode
for k ulong bytes
put code k get wcode k
end
ret bytes
end
