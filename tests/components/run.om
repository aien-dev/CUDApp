rt_nl
end
if or ge kind 6 or eq kind 2 eq kind 5
hp_cat Rt00007 len Rt00007
rt_nl
end
if or eq kind 2 ge kind 6
hp_cat Rt00008 len Rt00008
rt_nl
end
if and ge kind 3 le kind 5
rt_enc Rt00009 len Rt00009
rt_spec
hp_cat Rt00010 len Rt00010
rt_nl
end
if eq kind 1
hp_cat Rt00012 len Rt00012
rt_nl
hp_build Rt00011 len Rt00011
end
if eq kind 2
hp_cat Rt00014 len Rt00014
rt_nl
hp_build Rt00013 len Rt00013
end
if eq kind 3
hp_cat Rt00016 len Rt00016
rt_nl
hp_build Rt00015 len Rt00015
end
if eq kind 4
hp_cat Rt00018 len Rt00018
rt_nl
hp_build Rt00017 len Rt00017
end
if eq kind 5
hp_cat Rt00020 len Rt00020
rt_nl
hp_build Rt00019 len Rt00019
end
if and ge kind 6 le kind 7
rt_record kind
end
if and ge kind 8 le kind 10
hp_cat RtCap len RtCap
rt_nl
if eq kind 8
hp_build RtCapB len RtCapB
else
rt_uncap sub kind 8
if eq kind 9
hp_build RtCapM1 len RtCapM1
else
hp_build RtCapM2 len RtCapM2
end
end
end
if eq kind 11
rt_val
end
end
