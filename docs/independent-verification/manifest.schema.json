{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUDA++ independent GPU evidence collection, not an acceptance verdict",
  "description": "Structural validation only. COLLECTED is not PASS. Hashes, references, chronology, independence and physical events require separate review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_kind",
    "claim_status",
    "operator",
    "identities",
    "checks",
    "artifacts",
    "commands",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "cudapp-independent-gpu-collection-v1"},
    "record_kind": {"enum": ["template", "operator_report"]},
    "claim_status": {"const": "NOT_EVALUATED"},
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "relationship_to_author", "independence_review", "review_artifact"],
      "properties": {
        "identity": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "relationship_to_author": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "independence_review": {"enum": ["NOT_REVIEWED", "SELF_REPORTED", "REVIEWED"]},
        "review_artifact": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"independence_review": {"const": "REVIEWED"}}},
          "then": {
            "properties": {
              "identity": {"type": "string", "minLength": 1},
              "relationship_to_author": {"type": "string", "minLength": 1},
              "review_artifact": {"$ref": "#/$defs/id"}
            }
          }
        }
      ]
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_repository",
        "candidate_commit",
        "dirty_patch_sha256",
        "compiler_repository",
        "compiler_commit",
        "compiler_binary_sha256",
        "unit_sha256",
        "executable_sha256",
        "kernel_sha256",
        "launch_sha256",
        "oracle_source_sha256",
        "input_sha256",
        "expected_output_sha256"
      ],
      "properties": {
        "candidate_repository": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "candidate_commit": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "dirty_patch_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "compiler_repository": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "compiler_commit": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "compiler_binary_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "unit_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "executable_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "kernel_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "launch_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "oracle_source_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "input_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "expected_output_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_provenance",
        "exact_source_build",
        "host_suite",
        "challenge_custody",
        "cpu_oracle",
        "device_identity",
        "admission",
        "correct_kernel",
        "guard_canaries",
        "wrong_kernel",
        "restored_kernel",
        "no_submission",
        "static_dependencies",
        "dynamic_execution",
        "public_sanitization",
        "independent_report",
        "second_machine",
        "toolkit_absent_environment"
      ],
      "properties": {
        "source_provenance": {"$ref": "#/$defs/check"},
        "exact_source_build": {"$ref": "#/$defs/check"},
        "host_suite": {"$ref": "#/$defs/check"},
        "challenge_custody": {"$ref": "#/$defs/check"},
        "cpu_oracle": {"$ref": "#/$defs/check"},
        "device_identity": {"$ref": "#/$defs/check"},
        "admission": {"$ref": "#/$defs/check"},
        "correct_kernel": {"$ref": "#/$defs/check"},
        "guard_canaries": {"$ref": "#/$defs/check"},
        "wrong_kernel": {"$ref": "#/$defs/check"},
        "restored_kernel": {"$ref": "#/$defs/check"},
        "no_submission": {"$ref": "#/$defs/check"},
        "static_dependencies": {"$ref": "#/$defs/check"},
        "dynamic_execution": {"$ref": "#/$defs/check"},
        "public_sanitization": {"$ref": "#/$defs/check"},
        "independent_report": {"$ref": "#/$defs/check"},
        "second_machine": {"$ref": "#/$defs/check"},
        "toolkit_absent_environment": {"$ref": "#/$defs/check"}
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"record_kind": {"const": "template"}}},
      "then": {
        "properties": {
          "operator": {
            "const": {
              "identity": null,
              "relationship_to_author": null,
              "independence_review": "NOT_REVIEWED",
              "review_artifact": null
            }
          },
          "identities": {
            "const": {
              "candidate_repository": null,
              "candidate_commit": null,
              "dirty_patch_sha256": null,
              "compiler_repository": null,
              "compiler_commit": null,
              "compiler_binary_sha256": null,
              "unit_sha256": null,
              "executable_sha256": null,
              "kernel_sha256": null,
              "launch_sha256": null,
              "oracle_source_sha256": null,
              "input_sha256": null,
              "expected_output_sha256": null
            }
          },
          "artifacts": {"maxItems": 0},
          "commands": {"maxItems": 0},
          "checks": {
            "properties": {
              "source_provenance": {"properties": {"status": {"const": "NOT_RUN"}}},
              "exact_source_build": {"properties": {"status": {"const": "NOT_RUN"}}},
              "host_suite": {"properties": {"status": {"const": "NOT_RUN"}}},
              "challenge_custody": {"properties": {"status": {"const": "NOT_RUN"}}},
              "cpu_oracle": {"properties": {"status": {"const": "NOT_RUN"}}},
              "device_identity": {"properties": {"status": {"const": "NOT_RUN"}}},
              "admission": {"properties": {"status": {"const": "NOT_RUN"}}},
              "correct_kernel": {"properties": {"status": {"const": "NOT_RUN"}}},
              "guard_canaries": {"properties": {"status": {"const": "NOT_RUN"}}},
              "wrong_kernel": {"properties": {"status": {"const": "NOT_RUN"}}},
              "restored_kernel": {"properties": {"status": {"const": "NOT_RUN"}}},
              "no_submission": {"properties": {"status": {"const": "NOT_RUN"}}},
              "static_dependencies": {"properties": {"status": {"const": "NOT_RUN"}}},
              "dynamic_execution": {"properties": {"status": {"const": "NOT_RUN"}}},
              "public_sanitization": {"properties": {"status": {"const": "NOT_RUN"}}},
              "independent_report": {"properties": {"status": {"const": "NOT_RUN"}}},
              "second_machine": {"properties": {"status": {"const": "NOT_RUN"}}},
              "toolkit_absent_environment": {"properties": {"status": {"const": "NOT_RUN"}}}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])", "minLength": 64, "maxLength": 64},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])", "minLength": 40, "maxLength": 40},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observation", "evidence", "commands"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "BLOCKED", "FAILED", "COLLECTED"]},
        "observation": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "commands": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "COLLECTED"}}},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "NOT_RUN"}}},
          "then": {"properties": {"evidence": {"maxItems": 0}, "commands": {"maxItems": 0}}}
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "public_path",
        "sha256",
        "bytes",
        "redaction",
        "raw_sha256",
        "raw_custody",
        "sanitization_report"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "public_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*(?![\\s\\S])",
          "not": {"pattern": "(^|/)\\.\\.(/|$)"}
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "redaction": {"enum": ["none", "sanitized"]},
        "raw_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "raw_custody": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "sanitization_report": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"redaction": {"const": "sanitized"}}},
          "then": {
            "properties": {
              "raw_sha256": {"$ref": "#/$defs/sha256"},
              "raw_custody": {"type": "string", "minLength": 1},
              "sanitization_report": {"$ref": "#/$defs/id"}
            }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "cwd_token",
        "started_utc",
        "ended_utc",
        "exit_code",
        "stdout_artifact",
        "stderr_artifact"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "command": {"type": "string", "minLength": 1},
        "cwd_token": {"type": "string", "minLength": 1},
        "started_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z(?![\\s\\S])"
        },
        "ended_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z(?![\\s\\S])"
        },
        "exit_code": {"type": "integer"},
        "stdout_artifact": {"$ref": "#/$defs/id"},
        "stderr_artifact": {"$ref": "#/$defs/id"}
      },
      "description": "UTC timestamp lexical profile excludes leap seconds. Calendar validity requires date-time format support or separate checking; chronology remains manual."
    }
  }
}
