note Exact source: CUDApp b759afc3 src/omega_blackwell_codegen_moe2.c and moe.h.
note Concatenate bw_alloc,bw_effect,bw_project,rowpipe. No solving or encoding here.
note Frozen spec8:0K,1lane_bytes,2rows,3warps,4mutant MUST0,5..7reserved MUST0.
note Unlike ignored C tuning fields this interface never silently accepts variants.
note Returns0 unsolved IR,1 refused spec,2 emitter capacity. Outputs zero on refusal.
note stats4=count,vregs,uvregs,sharedBytes; launch declares one CTA barrier.
note SB_B data waits only at first takeover; SB_RD protects each load address.
note Runtime loop consumes every issued B set before EXIT; branch/reconvergence order unchanged.
note Private state32..41shape,42..48branchsites,49partial,50step,51row,52word,
note 53weight,54dot/acc,55dot,56scale,57sharedoffset;10..12lowering scratch.
note Shape admission does not solve resources: caller globally allocates with limit128.
fn rp_check spec view ulong 8 to uint
if or eq get spec 0 0 gt get spec 0 32768
ret 1
end
if and ne get spec 1 8 ne get spec 1 16
ret 1
end
if and ne get spec 2 1 and ne get spec 2 2 and ne get spec 2 4 ne get spec 2 8
ret 1
end
if or eq get spec 3 0 gt get spec 3 32
ret 1
end
for j ulong 4
if ne get spec add j 4 0
ret 1
end
end
if ne rem get spec 0 mul get spec 1 32 0
ret 1
end
ks = div get spec 0 mul get spec 1 32
if or gt ks 16 gt mul mul get spec 2 ks get spec 1 128
ret 1
end
if gt get spec 0 mul get spec 3 512
ret 1
end
if ge add mul sub get spec 2 1 get spec 0 get spec 1 shl ulong 1 23
ret 1
end
ret 0
end
fn rp_zero ins edit ulong 8192 m edit ulong 2048 stats edit ulong 4 to void
for j ulong 8192
put ins j 0
end
for j ulong 2048
put m j 0
end
for j ulong 4
put stats j 0
end
end
fn rp_widx row ulong step ulong to ulong
ret add ulong 64 mul add mul row 16 step 2
end
fn rp_regrow m edit ulong 2048 s edit ulong 64 r edit ulong 512 row ulong to void
uv = bc_vreg s m 1 false
put r add 32 mul row 2 uv
uv = bc_vreg s m 1 false
put r add 33 mul row 2 uv
for step ulong get s 36
idx = rp_widx row step
uv = bc_vreg s m get s 38 false
put r idx uv
uv = bc_vreg s m get s 38 false
put r add idx 1 uv
end
end
fn rp_regs m edit ulong 2048 s edit ulong 64 r edit ulong 512 to void
uv = bc_vreg s m 2 true
for j ulong 24
w = ulong 1
if or lt j 3 or and ge j 14 le j 16 and ge j 18 le j 19
w = 2
end
put r j bc_vreg s m w false
end
put r 24 bc_vreg s m 4 false
for row ulong get s 34
rp_regrow m s r row
end
for step ulong get s 36
put r add 320 mul step 2 bc_vreg s m 1 false
put r add 321 mul step 2 bc_vreg s m 1 false
end
for j ulong 7
w = ulong 1
if lt j 5
w = 2
end
put r add j 25 bc_vreg s m w false
end
for j ulong 5
put r add j 48 bc_vreg s m 1 false
end
for j ulong 9
w = ulong 1
if eq j 0
w = 2
end
put r add j 352 bc_vreg s m w false
end
for j ulong get s 41
put r add 384 mul j 2 bc_vreg s m 2 false
put r add 385 mul j 2 bc_vreg s m 1 false
end
end
