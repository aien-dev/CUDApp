meta = new ulong 2048 0
phys = new ulong 288 0
fresh = new ulong 8 0
if ne bc_compose cfg ins meta phys fresh 0
ret 13
end
for j ulong 8
if ne get fresh j get out j
ret 14
end
put out j get fresh j
end
ret ru_fill cfg b l out
end
fn ru_fill cfg view ulong 16 b edit uchar 4096 l edit ulong 32 out view ulong 8 to int
