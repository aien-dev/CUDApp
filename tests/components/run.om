note Build a concrete weak-GPR checker mutant without changing checked-in production source.
fn rt_weak to void
hits = ulong 0
used = get HUsed 0
for pos ulong sub used len RtGuard
same = uint 1
for j ulong len RtGuard
if ne get HSrc add pos j get RtGuard j
same = 0
end
end
if ne same 0
hits = add hits 1
for j ulong len RtGuard
c = uchar 32
if lt j len RtWeak
c = get RtWeak j
end
put HSrc add pos j c
end
end
end
hp_require eq hits 1
end
fn rt_record kind ulong to void
path = new uchar 1024 0
n = rt_qpath path
hp_cat path n
rt_nl
hp_cat Rt00095 len Rt00095
rt_nl
hp_cat RtAdmit len RtAdmit
rt_nl
hp_cat Rt00094 len Rt00094
rt_nl
hp_cat RtRUnit len RtRUnit
rt_nl
if eq kind 7
rt_weak
hp_build RtRMut len RtRMut
else
hp_build RtRBin len RtRBin
end
end

fn rt_uncap which ulong to void
hits = ulong 0
for pos ulong sub get HUsed 0 len RtCapIf
same = true
for j ulong len RtCapIf
if ne get HSrc add pos j get RtCapIf j
same = false
end
end
if same
hits = add hits 1
if eq hits which
for j ulong len RtCapIf
c = uchar 32
if lt j len RtWeak
c = get RtWeak j
end
put HSrc add pos j c
end
end
end
end
hp_require eq hits 2
end
fn rt_nl to void
pos = get HUsed 0
hp_require lt pos len HSrc
put HSrc pos 10
put HUsed 0 add pos 1
end
fn rt_path suffix view uchar * n ulong dst edit uchar 1024 to ulong
used = get HEn 0
hp_require le add add used 1 n 1024
for j ulong used
put dst j get HEnc j
end
put dst used 47
for j ulong n
put dst add add used 1 j get suffix j
end
ret add add used 1 n
end
fn rt_enc suffix view uchar * n ulong to void
path = new uchar 1024 0
used = rt_path suffix n path
hp_cat path used
rt_nl
end
fn rt_spec to void
