#!/bin/bash
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# cudapp: swap NVIDIA's CUDA stack for CUDA++ and back, one command each way.
#
#   cudapp swap status            what is installed, what is loaded, what the loader finds, who holds the GPU
#   cudapp swap user   [--yes]    user space: programs load CUDA++'s libcuda.so.1 instead of NVIDIA's
#   cudapp swap kernel [--yes]    kernel: NVIDIA's modules held back, AIEN's aien_gpu driver loads (next boot)
#   cudapp swap all    [--yes]    both
#   cudapp swap back   [--yes]    NVIDIA's stack exactly as it was (every touched file checked by SHA-256)
#   cudapp run CMD...             one program on CUDA++'s libcuda.so.1, nothing on the system changed
#
# Without --yes every level is a dry run: it checks, prints what it would change, and changes nothing.
# Every file it changes is copied first into /var/lib/cudapp-swap/backup-<UTC>-<level>/ with a manifest of
# path, state and SHA-256; `back` copies them back and checks every hash. NVIDIA's own files are never edited or
# removed: the user level only adds a library directory the loader searches first, the kernel level only adds a
# hold-back file and our module. It never reboots unless --reboot is given.
#
# Exit codes: 0 done (or dry run printed), 1 failed (back: a hash did not match), 2 usage, 3 refused by a check.
# docs/SWAP.md has the details and the receipts.
set -u
ROOT=${CUDAPP_ROOT:-}
STATE=$ROOT/var/lib/cudapp-swap
SELF_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
LIB_SRC=${CUDAPP_LIB:-$SELF_DIR/../build/swap/libcuda.so.1}
DRIVER_SRC=${CUDAPP_DRIVER_SRC:-$HOME/workspace/aienos-own-gpu-driver/native/linux/aien-gpu}
KVER=$(uname -r)
KDIR=${CUDAPP_KDIR:-/lib/modules/$KVER/build}

OUR_LIBDIR=/usr/lib/cudapp
LDCONF=/etc/ld.so.conf.d/00000-cudapp-swap.conf   # sorts before every other entry in C and UTF-8 collation
LDCACHE=/etc/ld.so.cache
MODCONF=/etc/modprobe.d/cudapp-swap-kernel.conf
MODLOAD=/etc/modules-load.d/cudapp-aien-gpu.conf
MODDIR=/lib/modules/$KVER/updates/cudapp
INITRD=/boot/initrd.img-$KVER
NV_MODULES="nvidia nvidia_uvm nvidia_modeset nvidia_drm"

YES=0; REBOOT=0; HOLDERS_OK=0
die()    { echo "cudapp: $*" >&2; exit 1; }
refuse() { echo "REFUSED: $*" >&2; exit 3; }
usage()  { sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
sha()    { if [ -e "$1" ] || [ -L "$1" ]; then sha256sum < "$1" | cut -d' ' -f1; else echo -; fi; }

# ---------------------------------------------------------------- facts
gpu_ids() { # prints "vendor:device" of every NVIDIA PCI function
    local d
    for d in "$ROOT"/sys/bus/pci/devices/*; do
        [ -r "$d/vendor" ] || continue
        [ "$(cat "$d/vendor")" = 0x10de ] || continue
        echo "10de:$(sed 's/^0x//' "$d/device")"
    done
}
is_gb10()       { gpu_ids | grep -qx "10de:2e12"; }
nv_version()    { cat "$ROOT/sys/module/nvidia/version" 2>/dev/null || echo "not loaded"; }
secure_boot()   { local s; s=$(mokutil --sb-state 2>/dev/null); case $s in *enabled*) echo enabled;; *disabled*) echo disabled;; *) echo unknown;; esac; }
holders()       { fuser "$ROOT"/dev/nvidia* 2>/dev/null | tr -s ' :' '\n' | grep -E '^[0-9]+$' | sort -un | tr '\n' ' '; }
free_mb()       { df -Pm "${ROOT:-/}" 2>/dev/null | awk 'NR==2{print $4}'; }
loader_choice() { # which libcuda.so.1 the dynamic loader finds first
    if [ -n "$ROOT" ]; then
        if [ -f "$ROOT$LDCONF" ] && [ -e "$ROOT$OUR_LIBDIR/libcuda.so.1" ]; then echo "$OUR_LIBDIR/libcuda.so.1"; return; fi
        echo "/usr/lib/aarch64-linux-gnu/libcuda.so.1"; return
    fi
    ldconfig -p 2>/dev/null | awk '$1=="libcuda.so.1"{print $NF; exit}'
}
user_swapped()   { [ -f "$ROOT$LDCONF" ]; }
kernel_staged()  { [ -f "$ROOT$MODCONF" ]; }
nv_in_initramfs(){ lsinitramfs "$ROOT$INITRD" 2>/dev/null | grep -qE '/nvidia(_uvm|_modeset|_drm)?\.ko'; }

status() {
    local ids; ids=$(gpu_ids | tr '\n' ' ')
    if is_gb10; then echo "GPU: NVIDIA GB10 (10de:2e12)"; else echo "GPU: ${ids:-no NVIDIA GPU found} (not a GB10)"; fi
    echo "NVIDIA kernel driver: $(nv_version)"
    echo "Secure Boot: $(secure_boot)"
    echo "free disk: $(free_mb) MB"
    local h; h=$(holders); echo "holding /dev/nvidia*: ${h:-nobody}"
    local c; c=$(loader_choice)
    case $c in *cudapp*) echo "libcuda.so.1: CUDA++ ($c)";; "") echo "libcuda.so.1: none found";; *) echo "libcuda.so.1: NVIDIA ($c)";; esac
    if user_swapped; then echo "user level: SWAPPED (CUDA++ libcuda.so.1 first in the loader's search)"; else echo "user level: NVIDIA"; fi
    if kernel_staged; then
        if [ -d "$ROOT/sys/module/aien_gpu" ] && [ ! -d "$ROOT/sys/module/nvidia" ]; then echo "kernel level: SWAPPED (aien_gpu loaded, NVIDIA held back)"
        else echo "kernel level: STAGED (takes effect at the next boot)"; fi
    else echo "kernel level: NVIDIA"; fi
    local b; b=$(ls -d "$STATE"/backup-* 2>/dev/null | tr '\n' ' '); echo "backups: ${b:-none}"
}

# ---------------------------------------------------------------- backup + restore
BK=""
backup_begin() { # $1 = level
    BK=$STATE/backup-$(date -u +%Y%m%dT%H%M%SZ)-$1
    mkdir -p "$BK/files" || die "cannot create $BK"
    : > "$BK/manifest.tsv"
}
backup_file() { # $1 = path (system path, without ROOT): copy + record state and hash before we touch it
    local p=$1 f=$ROOT$1
    grep -q "^$p	" "$BK/manifest.tsv" 2>/dev/null && return 0
    if [ -L "$f" ]; then
        printf '%s\tlink\t%s\n' "$p" "$(readlink "$f")" >> "$BK/manifest.tsv"
    elif [ -e "$f" ]; then
        mkdir -p "$BK/files$(dirname "$p")"; cp -p "$f" "$BK/files$p" || die "backup of $p failed"
        printf '%s\tfile\t%s\n' "$p" "$(sha "$f")" >> "$BK/manifest.tsv"
    else
        printf '%s\tabsent\t-\n' "$p" >> "$BK/manifest.tsv"
    fi
}
backup_done() { echo applied > "$BK/APPLIED"; echo "backup: $BK ($(wc -l < "$BK/manifest.tsv") files recorded)"; }

restore_one() { # $1 = backup dir; restores and checks; prints MISMATCH lines; returns count of mismatches
    local b=$1 bad=0 p kind val f
    while IFS=$'\t' read -r p kind val; do
        f=$ROOT$p
        case $kind in
            absent) rm -f "$f"
                    if [ -e "$f" ] || [ -L "$f" ]; then echo "MISMATCH $p: still present"; bad=$((bad+1)); fi ;;
            link)   rm -f "$f"; ln -s "$val" "$f"
                    [ "$(readlink "$f")" = "$val" ] || { echo "MISMATCH $p: link"; bad=$((bad+1)); } ;;
            file)   mkdir -p "$(dirname "$f")"; rm -f "$f"; cp -p "$b/files$p" "$f"
                    [ "$(sha "$f")" = "$val" ] || { echo "MISMATCH $p: sha256 $(sha "$f") != recorded $val"; bad=$((bad+1)); } ;;
        esac
    done < <(tac "$b/manifest.tsv")
    rmdir "$ROOT$OUR_LIBDIR" "$ROOT$MODDIR" 2>/dev/null   # only the directories this tool creates, and only if empty
    return $bad
}

# ---------------------------------------------------------------- levels
plan() { if [ $YES -eq 1 ]; then echo "  * $*"; else echo "  - would: $*"; fi; }

user_level() {
    echo "== user level: CUDA++ libcuda.so.1 replaces NVIDIA's for every program the loader starts"
    [ -f "$LIB_SRC" ] || refuse "CUDA++ libcuda.so.1 not built at $LIB_SRC (run: make libcuda)"
    user_swapped && { echo "already swapped ($LDCONF present); nothing to do"; return 0; }
    plan "install $LIB_SRC as $OUR_LIBDIR/libcuda.so.1 (sha256 $(sha "$LIB_SRC" | cut -c1-16))"
    plan "write $LDCONF -> $OUR_LIBDIR, so the loader searches it before $(loader_choice | xargs -r dirname)"
    plan "run ldconfig (rewrites $LDCACHE; the old one is kept in the backup)"
    echo "  NVIDIA's libcuda files stay installed and unchanged; 'cudapp swap back' restores the old search order."
    [ $YES -eq 1 ] || return 0
    backup_begin user
    backup_file "$OUR_LIBDIR/libcuda.so.1"; backup_file "$LDCONF"; backup_file "$LDCACHE"
    mkdir -p "$ROOT$OUR_LIBDIR" && install -m 0755 "$LIB_SRC" "$ROOT$OUR_LIBDIR/libcuda.so.1" || die "install failed"
    echo "$OUR_LIBDIR" > "$ROOT$LDCONF"
    ldconfig ${ROOT:+-r "$ROOT"} || die "ldconfig failed"
    backup_done
    local c; c=$(loader_choice)
    case $c in *cudapp*) echo "loader now finds: $c";; *) echo "loader still finds $c: restoring"; restore_one "$BK"; mv "$BK" "$BK.undone"; die "swap did not take";; esac
}

kernel_level() {
    echo "== kernel level: AIEN's aien_gpu driver (ledger L332) instead of NVIDIA's open kernel modules"
    is_gb10 || refuse "no GB10 here (found: $(gpu_ids | tr '\n' ' ')); aien_gpu drives the GB10 (10de:2e12) only"
    local sb; sb=$(secure_boot)
    [ "$sb" = enabled ] && refuse "Secure Boot is enabled: the kernel would refuse the unsigned aien_gpu module and boot with no GPU driver. Disable Secure Boot or enrol a signing key first."
    [ -f "$DRIVER_SRC/Kbuild" ] || refuse "aien_gpu source not found at $DRIVER_SRC (set CUDAPP_DRIVER_SRC)"
    [ -d "$KDIR" ] || refuse "kernel headers for $KVER not found at $KDIR (install linux-headers-$KVER)"
    local h; h=$(holders)
    if [ -n "$h" ]; then
        echo "  processes holding /dev/nvidia* (they lose the GPU at the reboot): $h"
        [ $YES -eq 1 ] && [ $HOLDERS_OK -eq 0 ] && refuse "processes hold /dev/nvidia*: $h. Stop them (or pass --holders-ok to stage the switch for the next boot anyway)."
    fi
    local need=$(( $(stat -c %s "$ROOT$INITRD" 2>/dev/null || echo 0) / 1048576 * 2 + 64 ))
    [ "$(free_mb)" -ge "$need" ] 2>/dev/null || refuse "not enough free disk: need $need MB for the module and the initramfs backup, have $(free_mb) MB"
    plan "build aien_gpu.ko from $DRIVER_SRC for kernel $KVER and install it as $MODDIR/aien_gpu.ko"
    plan "write $MODCONF: blacklist + 'install <m> /bin/false' for $NV_MODULES (nothing loads them, not even an explicit modprobe)"
    plan "write $MODLOAD: load aien_gpu at boot (options aien_gpu allow_bind=1)"
    plan "run depmod -a $KVER (modules.* files are kept in the backup)"
    if nv_in_initramfs; then plan "run update-initramfs -u -k $KVER (NVIDIA modules are in $INITRD; the old initramfs is kept in the backup)"
    else echo "  initramfs: no NVIDIA module in $INITRD, the hold-back file is enough (not rebuilt)"; fi
    echo "  takes effect at the next reboot: NVIDIA's modules then stay unloaded and aien_gpu owns the GB10."
    echo "  Why a reboot: unloading nvidia_modeset can hang on this machine (L158), so the switch never unloads a live driver."
    echo "  NVIDIA's signed GSP firmware stays installed; aien_gpu loads it (the chip checks its signature)."
    [ $YES -eq 1 ] || return 0
    backup_begin kernel
    local m
    backup_file "$MODDIR/aien_gpu.ko"; backup_file "$MODCONF"; backup_file "$MODLOAD"
    for m in "$ROOT"/lib/modules/$KVER/modules.*; do [ -e "$m" ] && backup_file "${m#$ROOT}"; done
    nv_in_initramfs && backup_file "$INITRD"
    local B; B=$(mktemp -d) && cp -r "$DRIVER_SRC"/. "$B"/ || die "copy of driver source failed"
    make -C "$KDIR" M="$B" modules > "$BK/build.log" 2>&1 || { cat "$BK/build.log" >&2; die "aien_gpu build failed (log $BK/build.log)"; }
    local vm; vm=$(modinfo -F vermagic "$B/aien_gpu.ko" 2>/dev/null; modinfo "$B/aien_gpu.ko" 2>/dev/null | awk '/^vermagic/{print $2}')
    grep -q "$KVER" <<<"$vm" || die "built module vermagic '$vm' does not match running kernel $KVER"
    mkdir -p "$ROOT$MODDIR" && install -m 0644 "$B/aien_gpu.ko" "$ROOT$MODDIR/aien_gpu.ko" || die "module install failed"
    rm -rf "$B"
    { echo "# cudapp swap kernel: NVIDIA's kernel modules held back, AIEN aien_gpu drives the GB10. Undo: cudapp swap back"
      for m in $NV_MODULES; do echo "blacklist $m"; echo "install $m /bin/false"; done
      echo "options aien_gpu allow_bind=1"; } > "$ROOT$MODCONF"
    { echo "# cudapp swap kernel"; echo "aien_gpu"; } > "$ROOT$MODLOAD"
    depmod -a "$KVER" || die "depmod failed"
    if nv_in_initramfs || [ -f "$BK/files$INITRD" ]; then update-initramfs -u -k "$KVER" || die "update-initramfs failed"; fi
    backup_done
    echo "kernel level STAGED: reboot to switch. To return: cudapp swap back --yes, then reboot."
    if [ $REBOOT -eq 1 ]; then
        [ "$(hostname 2>/dev/null)" = spark-b87b ] && [ -z "${SPARK_WINDOW:-}" ] && refuse "on the Spark the reboot runs only inside a scheduled spark-window"
        echo "rebooting (--reboot)"; reboot
    fi
}

back_level() {
    local list; list=$(ls -d "$STATE"/backup-* 2>/dev/null | grep -v -e '\.undone$' -e '\.restored$' | LC_ALL=C sort -r)
    [ -n "$list" ] || { echo "nothing to restore: no applied backup in $STATE"; return 0; }
    echo "== back: restore NVIDIA's stack from"; echo "$list" | sed 's/^/   /'
    local b
    for b in $list; do [ -f "$b/APPLIED" ] && sed 's/^/  - restore: /' "$b/manifest.tsv"; done
    [ $YES -eq 1 ] || { echo "DRY RUN: nothing changed. Run again with --yes."; return 0; }
    local total=0 bad=0 n
    for b in $list; do
        [ -f "$b/APPLIED" ] || continue
        restore_one "$b"; n=$?; bad=$((bad+n)); total=$((total+$(wc -l < "$b/manifest.tsv")))
        [ $n -eq 0 ] && mv "$b" "$b.restored"
    done
    if [ $bad -eq 0 ]; then
        echo "BACK PASS: $total files match their pre-swap state (sha256)"
        [ -d "$ROOT/sys/module/aien_gpu" ] && echo "aien_gpu is loaded now: reboot to give the GB10 back to NVIDIA's driver."
        return 0
    fi
    echo "BACK FAIL: $bad of $total files do not match; backups kept in $STATE"; return 1
}

# ---------------------------------------------------------------- main
[ $# -ge 1 ] || usage
cmd=$1; shift
if [ "$cmd" = run ]; then
    [ $# -ge 1 ] || usage
    d=$(cd "$(dirname "$LIB_SRC")" 2>/dev/null && pwd) || refuse "CUDA++ libcuda.so.1 not built at $LIB_SRC (run: make libcuda)"
    LD_LIBRARY_PATH=$d${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH} exec "$@"
fi
[ "$cmd" = swap ] || usage
[ $# -ge 1 ] || usage
level=$1; shift
for a in "$@"; do case $a in --yes) YES=1;; --reboot) REBOOT=1;; --holders-ok) HOLDERS_OK=1;; *) usage;; esac; done
case $level in status|user|kernel|all|back) ;; *) usage;; esac
if [ $YES -eq 1 ] && [ -z "$ROOT" ] && [ "$(id -u)" -ne 0 ]; then exec sudo -E "$0" swap "$level" "$@"; fi
case $level in
    status) status ;;
    user)   user_level ;;
    kernel) kernel_level ;;
    all)    user_level && kernel_level ;;
    back)   back_level ;;
esac
rc=$?
[ $YES -eq 0 ] && [ "$level" != status ] && [ "$level" != back ] && echo "DRY RUN: nothing changed. Run again with --yes."
exit $rc
