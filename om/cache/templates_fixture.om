fn kt_emitfixture to int
cubin = new uchar 32768 0
obs = new uchar 2048 0
sizes = new uchar 64 0
for i ulong div len kt_cbin 2
hi = get kt_cbin mul i 2
lo = get kt_cbin add mul i 2 1
put cubin i kt_byte hi lo
end
for i ulong 768
hi = get kt_qmd mul i 2
lo = get kt_qmd add mul i 2 1
put obs i kt_byte hi lo
end
for i ulong div len kt_args 2
hi = get kt_args mul i 2
lo = get kt_args add mul i 2 1
put obs add 768 i kt_byte hi lo
end
for i ulong len kt_fn
put obs add 896 i get kt_fn i
end
for i ulong 32
hi = get kt_id mul i 2
lo = get kt_id add mul i 2 1
put obs add 960 i kt_byte hi lo
end
for i ulong 64
put obs add 1024 i get kt_id i
end
kt_sz sizes 0 div len kt_cbin 2
kt_sz sizes 1 div len kt_args 2
kt_sz sizes 2 len kt_fn
if ne write 1 cubin 0 32768 32768
ret 92
end
if ne write 1 obs 0 2048 2048
ret 93
end
if ne write 1 sizes 0 64 64
