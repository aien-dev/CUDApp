fn neartests to void
for i ulong len PhraseA
put LText i get PhraseA i
end
for i ulong len PhraseB
put LText add 256 i get PhraseB i
end
check lnear len PhraseA len PhraseB 1
for i ulong len PhraseC
put LText add 256 i get PhraseC i
end
check lnear len PhraseA len PhraseC 0
check lnear 0 0 2
check lnear 257 1 3
put LText 0 255
check lnear len PhraseA len PhraseC 3
for i ulong len HalfA
put LText i get HalfA i
end
for i ulong len HalfB
put LText add 256 i get HalfB i
end
check lnear len HalfA len HalfB 0
for i ulong len Repeat
put LText i get Repeat i
put LText add 256 i get Repeat i
end
check lnear len Repeat len Repeat 1
for i ulong 128
put LText mul i 2 97
put LText add mul i 2 1 32
end
check lnear 256 5 3
end

fn countout to void
n = get Checks 0
put Digits 0 uchar add div n 100 48
put Digits 1 uchar add rem div n 10 10 48
put Digits 2 uchar add rem n 10 48
put Digits 3 10
w = write 1 Digits 0 4
if ne w 4
exit 36
end
end

fn main to int
manifesttests
observationtests
accountingtests
neartests
w = write 1 Good 0 len Good
if ne w long len Good
ret 35
end
countout
ret 0
end
