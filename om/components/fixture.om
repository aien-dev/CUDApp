note Host fixture ONLY: digest sentinels are synthetic, never an admission receipt.
fn compose_setid b edit uchar 4096 slot ulong h view uchar 32 to void
if lt slot 8
for j ulong 32
put b add add 512 mul slot 32 j get h j
end
end
end
