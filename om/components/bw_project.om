bc_pred ins s get r 30 get r 12
at = bc_branch ins s get s 43 true
bc_epilogue ins s r
bc_imm ins s get r 23 get r 6 get r 23 1
at = bc_branch ins s get s 41 false
bc_patch ins get s 42 get s 0
bc_node s 45 BCNONE BCNONE BCNONE BCNONE
bc_emit ins s 7
at = bc_branch ins s get s 0 false
note Historical tail BRA has exact fixed control independent of scheduler pending.
put ins add mul at 8 6 shl ulong 1032192 32
end
fn bc_project spec view ulong 8 ins edit ulong 8192 m edit ulong 2048 stats edit ulong 4 to uint
if ne bc_prcheck spec 0
ret 1
end
s = new ulong 64 0
r = new ulong 64 0
for k ulong 2048
put m k 0
end
for k ulong 8192
put ins k 0
end
for k ulong 5
put s add k 32 get spec k
end
put s 37 div get spec 0 mul get spec 1 32
put s 38 div get spec 1 4
put s 39 bc_log div ulong 128 get spec 1
put s 40 bc_log div ulong 128 get spec 2
bc_initregs m s r
bc_prbody ins s r
if ne get s 3 0
ret 2
end
put stats 0 get s 0
put stats 1 get s 4
put stats 2 get s 5
put stats 3 0
ret 0
end
