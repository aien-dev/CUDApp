fn capacity to void
fixture
note Unsupported shapes must be declared before collection, not dropped after observing costs.
for r ulong 7
if gt r 0
put srows mul r 11 0
end
end
check eq cstart 0
for i ulong 32
sample 0 i
check eq cadd 0
end
sample 0 32
check eq cadd 77
check eq get ccount 0 32
check eq get craw 506 137
check eq cseal 0
check eq get srows 11 0
put srows 11 1
check eq cseal 69
end
fn main to int
collect
reject
capacity
ret finish
end
