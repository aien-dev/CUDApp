note SPDX-License-Identifier: MIT
note Compile-only register-pressure probe; do not launch overlapping stores.
note Stdin: axis times thirty-two plus extra-live count, zero through ninety-five, then EOF.
global input uchar 2
global digits uchar 24
text start "#include <metal_stdlib>\nusing namespace metal;\nkernel void k(volatile device const uint *a [[buffer(0)]], volatile device const uint *b [[buffer(1)]], volatile device const uint *c [[buffer(2)]], device uint *out [[buffer(3)]], uint3 pos [[thread_position_in_grid]]) {\nuint gid=pos."
text axes "xyz"
text body ";\nuint va=a[gid]; uint vb=b[gid]; uint vc=c[gid];\n"
text loadhead "uint v"
text loadmid "=a[gid+"
text loadtail "];\n"
text mathbody "out[gid] = va * vb + vc;\nout[gid+1] = va; out[gid+2] = vb; out[gid+3] = vc;\n"
text sthead "out[gid+"
text stmid "] = v"
text sttail ";\n"
text finish "}\n"
fn number value ulong to bool
n = ulong 0
again = true
while again
put digits n uchar add rem value 10 48
value = div value 10
n = add n 1
again = ne value 0
end
for i ulong n
if ne write 1 digits sub sub n i 1 1 1
ret false
end
end
ret true
end
fn loadline i ulong to bool
if ne write 1 loadhead 0 len loadhead long len loadhead
ret false
end
if not number i
ret false
end
if ne write 1 loadmid 0 len loadmid long len loadmid
ret false
end
if not number add i 1
ret false
end
ret eq write 1 loadtail 0 len loadtail long len loadtail
end
fn storeln i ulong to bool
if ne write 1 sthead 0 len sthead long len sthead
ret false
end
if not number add i 4
ret false
end
if ne write 1 stmid 0 len stmid long len stmid
ret false
end
if not number i
ret false
end
ret eq write 1 sttail 0 len sttail long len sttail
end
fn main to int
n = read 0 input 0 1
if lt n 0
ret 74
end
if ne n 1
ret 65
end
count = ulong get input 0
if gt count 95
ret 65
end
n = read 0 input 1 1
if lt n 0
ret 74
end
if ne n 0
ret 65
end
if ne write 1 start 0 len start long len start
ret 74
end
axis = div count 32
count = rem count 32
if ne write 1 axes axis 1 1
ret 74
end
if ne write 1 body 0 len body long len body
ret 74
end
for i ulong count
if not loadline i
ret 74
end
end
if ne write 1 mathbody 0 len mathbody long len mathbody
ret 74
end
for i ulong count
if not storeln i
ret 74
end
end
if ne write 1 finish 0 len finish long len finish
ret 74
end
ret 0
end
