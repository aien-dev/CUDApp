note ---- main
fn argto a ulong dst ulong to ulong
n = argread a abuf 0 4095
if le n 0
msg MUSAGE
exit 2
end
for i ulong ulong n
if eq dst 0
put pfx i get abuf i
end
if eq dst 1
put omcp i get abuf i
end
if eq dst 2
put frp i get abuf i
end
end
ret ulong n
end
fn fsize k ulong to ulong
n = mkpath k
fd = fopen pbuf 0 n 0 0
if lt fd 0
ret 0
end
r = fseek int fd 0 2
c = fclose int fd
if lt r 0
ret 0
end
ret ulong r
end
fn readerr to ulong
n = mkpath add PSUFFIX 2
fd = fopen pbuf 0 n 0 0
if lt fd 0
ret 0
end
k = readall int fd 1 len ebuf
c = fclose int fd
put om 16 k
ret k
end
fn compile to ulong
s = htbeg 1 2
for a ulong sub ulong argcnt 5
if not addunit add a 5
msg MUSAGE
exit 2
end
end
b = htend s get srcn 0 get ucnt 0 0
s = htbeg 1 3
if not writeunit
exit 5
end
b = htend s get srcn 0 lines 0 0
s = htbeg 1 4
ec = runomc
b = htend s fsize add PSUFFIX 1 ec long ec
s = htbeg 1 5
n = readerr
d = decode
b = htend s n d 0
ret ec
end
fn runphase to void
s = htbeg 9 6
x = runprog
b = htend s x esig long x
if and gt x 100 le x 114
c = sub x 100
scantrap c
b = htmark 8 uint add c 20 c get om 7 long x
end
end
fn fragphase to ulong
s = htbeg 1 8
c = loadfrag
b = htend s get om 8 c 0
ret c
end
fn main to int
pinit
if lt argcnt 3
msg MUSAGE
ret 2
end
n = argread 1 abuf 0 4095
if ne n 1
msg MUSAGE
ret 2
end
mode = get abuf 0
put om 5 ulong mode
if eq mode 118
put om 4 argto 2 2
c = loadfrag
msg MFOK
msgnum c
msg MNL
ret 0
end
if or lt argcnt 6 and and ne mode 99 ne mode 114 ne mode 102
msg MUSAGE
ret 2
end
put om 3 argto 2 1
put om 2 argto 3 0
f = argto 4 2
if and eq f 1 eq get frp 0 45
f = ulong 0
end
put om 4 f
ok = regall
ok = and ok htinit
root = htbeg 9 1
ec = compile
fc = ulong 0
if and eq ec 0 ne mode 99
runphase
if and eq mode 102 ne get om 4 0
fc = fragphase
end
end
b = htend root get ucnt 0 ec long ec
htstop
takeown
takefrag fc
basetime
parents
chrome
ok = and ok emit add PSUFFIX 3
otlp
ok = and ok emit add PSUFFIX 4
if not ok
msgnum get om 20
msg MNL
ret 4
end
if ne ec 0
msg MCOMPF
msgnum ec
msg MNL
ret 3
end
msg MOK
msgnum get om 0
msg MNL
ret 0
end
