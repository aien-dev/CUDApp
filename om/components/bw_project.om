fn bc_log v ulong to ulong
for i ulong 32
if eq shl ulong 1 i v
ret i
end
end
ret BCNONE
end
fn bc_imm ins edit ulong 8192 s edit ulong 64 d ulong a ulong c ulong imm ulong to void
put s 8 imm
put s 9 0
bc_imad ins s 8 d a c
end
fn bc_wide ins edit ulong 8192 s edit ulong 64 d ulong a ulong c ulong imm ulong to void
put s 8 imm
put s 9 0
bc_imad ins s 9 d a c
end
fn bc_shift ins edit ulong 8192 s edit ulong 64 d ulong a ulong subreg ulong amount ulong to void
bc_node s 17 d a BCNONE BCNONE
put s 22 amount
put s 23 shl subreg 24
bc_emit ins s 0
end
fn bc_mask ins edit ulong 8192 s edit ulong 64 d ulong a ulong subreg ulong mask ulong to void
bc_node s 18 d a BCNONE BCNONE
put s 22 mask
put s 23 shl subreg 24
bc_emit ins s 0
end
fn bc_initregs m edit ulong 2048 s edit ulong 64 r edit ulong 64 to void
uv = bc_vreg s m 2 true
for k ulong 31
width = ulong 1
if or lt k 3 and ge k 14 le k 16
width = 2
end
if or and ge k 18 le k 20 and ge k 24 le k 28
width = 2
end
put r k bc_vreg s m width false
end
for row ulong get s 34
put r add 32 mul row 2 bc_vreg s m 1 false
put r add 33 mul row 2 bc_vreg s m div get s 33 4 false
end
for word ulong get s 38
put r add word 48 bc_vreg s m 4 false
end
put r 52 bc_vreg s m 1 false
put r 53 bc_vreg s m 2 false
for k ulong 6
put r add k 54 bc_vreg s m 1 false
end
end
fn bc_prologue ins edit ulong 8192 s edit ulong 64 r view ulong 64 to void
bc_node s 7 0 BCNONE BCNONE BCNONE
put s 22 856
put s 23 1
bc_emit ins s 4
for k ulong 7
op = ulong 4
if lt k 3
op = 5
end
bc_node s op get r k BCNONE BCNONE BCNONE
put s 22 add ulong 896 mul k 8
if ge k 3
put s 22 add ulong 920 mul sub k 3 4
end
bc_emit ins s 2
end
for k ulong 3
bc_node s 3 get r add k 7 BCNONE BCNONE BCNONE
put s 22 33
if eq k 1
put s 22 37
end
if eq k 2
put s 22 38
end
bc_emit ins s 2
end
bc_inst ins s 2 get r 12 BCNONE 1
bc_shift ins s get r 10 get r 7 0 5
bc_mask ins s get r 11 get r 7 0 31
bc_imm ins s get r 13 get r 9 BCNONE 1
