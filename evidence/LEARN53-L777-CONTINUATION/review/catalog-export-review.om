note SPDX-License-Identifier: AGPL-3.0-only
note CUL1 public domain adapter. See docs/learn53/CONTRACT.md.
note Caller owns/pins kt; only ko contains candidate observations. No code execution.
global kt uchar 4096
global ko uchar 1032
fn kw i ulong to ulong
v = ulong 0
for j ulong 4
v = or v shl ulong get kt add mul i 4 j mul j 8
end
ret v
end
fn kc i ulong to ulong
v = ulong 0
for j ulong 4
v = or v shl ulong get ko add mul i 4 j mul j 8
end
ret v
end
fn kshape to ulong
op = kw 2
m = kw 5
n = kw 6
k = kw 7
if eq op 3
if eq m 2
if eq n 3
if eq k 2
ret 301
end
end
end
if eq m 3
if eq n 2
if eq k 3
ret 302
end
end
end
ret 0
end
if ne n 1
ret 0
end
if ne k 1
ret 0
end
base = mul op 100
if eq m 3
ret add base 1
end
if eq m 8
ret add base 2
end
if eq m 17
ret add base 3
end
ret 0
end
fn kextent rows ulong cols ulong stride ulong to ulong
ret add mul sub rows 1 stride cols
end
fn kstrides to int
op = kw 2
m = kw 5
if eq op 3
if lt kw 8 kw 7
ret 65
end
if lt kw 9 kw 6
ret 65
end
if lt kw 10 kw 6
ret 65
end
if ne kw 11 kextent m kw 7 kw 8
ret 65
end
if ne kw 12 kextent kw 7 kw 6 kw 9
ret 65
end
if ne kw 13 kextent m kw 6 kw 10
ret 65
end
ret 0
end
if eq kw 8 0
ret 65
end
if ne kw 11 kextent m 1 kw 8
ret 65
end
if eq op 2
if ne kw 9 0
ret 65
end
if ne kw 12 0
ret 65
end
if ne kw 10 1
ret 65
end
if ne kw 13 1
ret 65
end
ret 0
end
if eq kw 9 0
ret 65
end
if eq kw 10 0
ret 65
end
if ne kw 12 kextent m 1 kw 9
ret 65
end
if ne kw 13 kextent m 1 kw 10
ret 65
end
ret 0
end
fn kvalid n ulong to int
note All variable reads follow size/count validation. Bounds precede arithmetic.
if lt n 96
ret 65
end
if gt n 4096
ret 65
end
if ne kw 0 827086147
ret 65
end
if ne kw 1 1
ret 69
end
if gt kw 11 256
ret 65
end
if gt kw 12 256
ret 65
end
if eq kw 13 0
ret 65
end
if gt kw 13 256
ret 65
end
if ne n add 96 mul 4 add kw 11 kw 12
ret 65
end
if ne kw 23 0
ret 65
end
if eq kw 16 0
ret 65
end
if ne kw 21 0
ret 65
end
if ne kw 22 0
ret 65
end
if lt kw 2 1
ret 69
end
if gt kw 2 3
ret 69
end
if ne kw 3 1
ret 69
end
if ne kw 4 0
ret 69
end
if ne kw 17 1
ret 69
end
if ne kw 18 0
ret 69
end
if ne kw 19 1
ret 69
end
if ne kw 20 1
ret 69
end
if eq kw 14 0
ret 65
end
if gt kw 14 3
ret 65
end
if ne kw 14 1
ret 77
end
family = kshape
if eq family 0
ret 69
end
if ne kw 15 family
ret 65
end
for i ulong 3
if gt kw add i 8 32
ret 65
end
end
ret kstrides
end
fn ksum to ulong
v = ulong 0
for i ulong kw 5
v = and add v kw add 24 mul i kw 8 4294967295
end
ret v
end
fn kdot row ulong col ulong to ulong
v = ulong 0
for i ulong kw 7
a = kw add 24 add mul row kw 8 i
b = kw add add 24 kw 11 add mul i kw 9 col
v = and add v mul a b 4294967295
end
ret v
end
fn kexpect pos ulong to ulong
op = kw 2
if eq op 2
ret ksum
end
stride = kw 10
row = div pos stride
col = rem pos stride
if eq op 3
if ge col kw 6
ret 2779096485
end
ret kdot row col
end
if ne col 0
ret 2779096485
end
a = kw add 24 mul row kw 8
b = kw add add 24 kw 11 mul row kw 9
ret and add a b 4294967295
end
fn keval n ulong c ulong to int
status = kvalid n
if ne status 0
ret status
end
note Candidate result length is not trusted. No caller-supplied PASS or tolerance.
if ne c mul 4 add kw 13 2
ret 65
end
if ne kc 0 2779096485
ret 1
end
if ne kc add kw 13 1 2779096485
ret 1
end
for i ulong kw 13
if ne kc add i 1 kexpect i
ret 1
end
end
ret 0
end
note SPDX-License-Identifier: AGPL-3.0-only
note Eight fixed public development tasks. Not a sealed pool or a process runner.
fn kput p ulong v ulong to void
for i ulong 4
put kt add mul p 4 i uchar and shr v mul i 8 255
end
end
fn kbase id ulong to void
for i ulong 4096
put kt i 0
end
kput 0 827086147
kput 1 1
kput 3 1
kput 5 3
kput 6 1
kput 7 1
kput 8 2
kput 9 2
kput 10 2
kput 11 5
kput 12 5
kput 13 5
kput 14 1
kput 16 id
kput 17 1
kput 19 1
kput 20 1
end
fn klinear id ulong to void
if eq id 1
kput 2 1
kput 15 101
kput 24 4294967295
kput 25 111
kput 26 7
kput 27 222
kput 28 9
kput 29 1
kput 30 333
kput 31 4
kput 32 444
kput 33 6
ret
end
if eq id 4
kput 2 2
kput 15 201
kput 9 0
kput 10 1
kput 12 0
kput 13 1
kput 24 4294967295
kput 25 111
kput 26 2
kput 27 222
kput 28 3
ret
end
n = ulong 8
if or eq id 3 eq id 6
n = 17
end
kput 5 n
kput 8 1
kput 10 1
kput 11 n
if le id 3
kput 2 1
kput 9 1
kput 12 n
kput 13 n
kput 15 add 100 id
a = ulong 7
b = ulong 9
if eq id 3
a = 4294967295
b = 3
end
for i ulong n
kput add 24 i a
kput add add 24 n i b
end
else
kput 2 2
kput 9 0
kput 12 0
kput 13 1
kput 15 add 197 id
for i ulong n
kput add 24 i 4294967295
end
end
end
fn kmatrix id ulong to void
kput 2 3
if eq id 7
kput 5 2
kput 6 3
kput 7 2
kput 8 3
kput 9 4
kput 10 4
kput 11 5
kput 12 7
kput 13 7
kput 15 301
kput 24 1
kput 25 2
kput 26 999
kput 27 3
kput 28 4
kput 29 5
kput 30 6
kput 31 7
kput 32 999
kput 33 8
kput 34 9
kput 35 10
else
kput 5 3
kput 6 2
kput 7 3
kput 8 3
kput 9 2
kput 10 2
kput 11 9
kput 12 6
kput 13 6
kput 15 302
for i ulong 9
kput add 24 i add i 1
end
for i ulong 6
kput add 33 i add i 1
end
end
end
fn kload id ulong to ulong
note Reject before modifying either caller buffer. Valid loads never touch ko.
if or eq id 0 gt id 8
ret 0
end
kbase id
if le id 6
klinear id
else
kmatrix id
end
ret add 96 mul 4 add kw 11 kw 12
end
note SPDX-License-Identifier: AGPL-3.0-only
note Development fixture emitter: exactly one input byte, public catalog ID1..8.
global CIn uchar 2
fn main to int
pos = ulong 0
done = false
while eq done false bound 3
r = read 0 CIn pos sub 2 pos
if lt r 0
ret 74
end
if eq r 0
done = true
else
pos = add pos ulong r
if eq pos 2
ret 65
end
end
end
if ne pos 1
ret 65
end
n = kload ulong get CIn 0
if eq n 0
ret 77
end
pos = 0
while lt pos n bound 257
w = write 1 kt pos sub n pos
if le w 0
ret 74
end
pos = add pos ulong w
end
ret 0
end
