note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note CUDApp82 bounded HOST reference and wire codec. This does not execute on a GPU.
note Contract: docs/device-trace/CONTRACT.md. No timer instruction is emitted here.
global gtbytes uchar 4160
global gtstate ulong 9
fn gtput32 off ulong v uint to void
for i ulong 4
put gtbytes add off i uchar and shr v mul i 8 255
end
end
fn gtput64 off ulong v ulong to void
for i ulong 8
put gtbytes add off i uchar and shr v mul i 8 255
end
end
fn gtget32 off ulong to uint
v = uint 0
for i ulong 4
v = or v shl uint get gtbytes add off i mul i 8
end
ret v
end
fn gtget64 off ulong to ulong
v = ulong 0
for i ulong 8
v = or v shl ulong get gtbytes add off i mul i 8
end
ret v
end
fn gtextent to ulong
ret add 64 mul get gtstate 3 64
end
fn gtinit gen ulong kernel ulong manifest uint cap uint cta uint warp uint to bool
note Refusal invalidates the producer before inspecting a new configuration.
put gtstate 6 0
if or or eq gen 0 eq kernel 0 eq manifest 0
ret false
end
if or or gt cap 64 ge cta 16384 ge warp 2
ret false
end
for i ulong 4160
put gtbytes i 0
end
put gtstate 0 gen
put gtstate 1 kernel
put gtstate 2 ulong manifest
put gtstate 3 ulong cap
put gtstate 4 ulong cta
put gtstate 5 ulong warp
put gtstate 7 0
put gtstate 8 0
gtput32 0 1413958991
gtput32 4 1
gtput32 8 uint gtextent
gtput32 12 cap
gtput32 28 1
gtput64 32 gen
gtput64 40 kernel
gtput32 48 cta
gtput32 52 warp
gtput32 56 manifest
put gtstate 6 1
ret true
end
fn gtappend gen ulong site uint kind uint who uint stamp uint payload uint to long
note who is the logical VECTOR_1D thread index: CTA times64 plus thread.
if ne get gtstate 6 1
ret neg long 1
end
if ne gen get gtstate 0
ret neg long 2
end
if or or eq site 0 lt kind 1 gt kind 3
ret neg long 3
end
if ge who 1048576
ret neg long 3
end
if ne ulong div who 64 get gtstate 4
ret 1
end
if ne ulong rem who 64 mul get gtstate 5 32
ret 1
end
n = get gtstate 8
if ge n get gtstate 3
d = get gtstate 7
if lt d 4294967295
d = add d 1
else
gtput32 60 1
end
put gtstate 7 d
gtput32 20 uint d
ret 2
end
note cap is at most64 and n is below cap, so the last store is below4160.
off = add 64 mul n 64
gtput32 off site
gtput32 add off 4 kind
gtput32 add off 8 uint n
gtput32 add off 12 stamp
gtput64 add off 16 gen
gtput64 add off 24 get gtstate 1
gtput32 add off 32 uint get gtstate 4
gtput32 add off 36 uint get gtstate 5
gtput32 add off 40 0
gtput32 add off 44 payload
put gtstate 8 add n 1
gtput32 16 uint add n 1
ret 0
end
fn gtfinish status uint to bool
if or or ne get gtstate 6 1 lt status 1 gt status 3
ret false
end
gtput32 24 status
put gtstate 6 0
ret true
end
fn gtrowvalid row ulong to bool
off = add 64 mul row 64
if eq gtget32 off 0
ret false
end
kind = gtget32 add off 4
if or lt kind 1 gt kind 3
ret false
end
if ne ulong gtget32 add off 8 row
ret false
end
if ne gtget64 add off 16 gtget64 32
ret false
end
if ne gtget64 add off 24 gtget64 40
ret false
end
if ne gtget32 add off 32 gtget32 48
ret false
end
if ne gtget32 add off 36 gtget32 52
ret false
end
if ne gtget32 add off 40 0
ret false
end
for j ulong 16
if ne get gtbytes add add off 48 j 0
ret false
end
end
ret true
end
fn gtvalidate bytes ulong gen ulong kernel ulong manifest uint to bool
note bytes is the actual read count, not an advertised header extent.
if or lt bytes 64 gt bytes 4160
ret false
end
if or ne gtget32 0 1413958991 ne gtget32 4 1
ret false
end
cap = ulong gtget32 12
if gt cap 64
ret false
end
if ne bytes add 64 mul cap 64
ret false
end
if ne ulong gtget32 8 bytes
ret false
end
n = ulong gtget32 16
if gt n cap
ret false
end
if and ne gtget32 20 0 ne n cap
ret false
end
if or gt gtget32 24 3 ne gtget32 28 1
ret false
end
if or or eq gen 0 eq kernel 0 eq manifest 0
ret false
end
if or ne gtget64 32 gen ne gtget64 40 kernel
ret false
end
if ne gtget32 56 manifest
ret false
end
if or ge gtget32 48 16384 ge gtget32 52 2
ret false
end
if gt gtget32 60 1
ret false
end
if and eq gtget32 60 1 ne gtget32 20 4294967295
ret false
end
for i ulong n
if not gtrowvalid i
ret false
end
end
note Unused slots are canonical zero. No hidden records after the written prefix.
off = add 64 mul n 64
for i ulong sub bytes off
if ne get gtbytes add off i 0
ret false
end
end
ret true
end
