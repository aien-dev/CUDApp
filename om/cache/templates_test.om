note Independent admitted C exporter fixture, framed as launch4096/cubin32768/observed2048/sizes8LEu64.
note The driver performs no admission; stdin is verification-only. Runtime caller owns successful admission custody.
fn kt_sizes frame view uchar 38976 sizes edit ulong 8 to void
for i ulong 8
v = ulong 0
for j ulong 8
v = or v shl ulong get frame add add 38912 mul i 8 j mul j 8
end
put sizes i v
end
end
fn kt_obsmut launch edit uchar 4096 cubin view uchar 32768 obs edit uchar 2048 sizes view ulong 8 off ulong expected long to bool
old = get obs off
put obs off xor old 1
rc = native_templates launch cubin obs sizes
put obs off old
ret eq rc expected
end
fn kt_cubmut launch view uchar 4096 cubin edit uchar 32768 obs view uchar 2048 sizes view ulong 8 off ulong expected long to bool
old = get cubin off
put cubin off xor old 1
rc = native_templates launch cubin obs sizes
put cubin off old
ret eq rc expected
