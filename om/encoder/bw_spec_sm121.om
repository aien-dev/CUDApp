fn sp_init to void
if ne get sp_ok 0 0
ret
end
c_init0
c_init1
c_init2
c_init3
c_init4
c_init5
c_init6
put sp_ok 0 1
end

fn sp_find o view ulong 16 to ulong
op = get o 0
for i ulong 63
base = mul i 45
f_op = get sp_tbl base
if eq f_op op
var = get sp_tbl add base 1
if eq op 8
  if ne get o 13 0
    if eq var 0
      ret i
    end
  else
    if and ne get o 8 0 ne get o 14 0
      if eq var 1
        ret i
      end
    else
      if eq var 2
        ret i
      end
    end
  end
else
  if eq op 10
    if and ne get o 8 0 ne get o 14 0
      if eq var 0
        ret i
      end
    else
      if eq var 1
        ret i
      end
    end
  else
    ret i
  end
end
end
end
ret 63
end

fn sp_val role ulong word ulong o view ulong 16 to ulong
if or eq role R_RD eq role R_URD
ret get o 1
end
if or eq role R_RA eq role R_URA
ret get o 2
end
if eq role R_RB
ret get o 3
end
if eq role R_URB
op = get o 0
if or eq op 6 eq op 7
ret get o 1
end
ret get o 5
end
if eq role R_RC
ret get o 4
end
if eq role R_PRED3
if eq word 0
ret and get o 1 7
end
ret and get o 4 7
end
if eq role R_PRED
if eq get o 9 0
ret 7
end
if eq get o 10 0
ret 0
end
ret 8
end
if eq role R_BAR
ret get o 11
end
if eq role R_SHFL
ret and get o 6 31
end
if eq role R_LUT
ret and get o 6 255
end
ret get o 6
end

fn off24 imm ulong to bool
ret or lt imm 8388608 ge imm 4286578688
end

fn sp_chkr role ulong val ulong min_v ulong max_v ulong to bool
if eq role R_OFF24
ret off24 val
end
if eq role R_BSSY
ret not or lt val 2 ge val 2147483648
end
if eq role R_LDSW
ret lt val 8388608
end
if eq role R_BRA
ret true
end
ret not or lt val min_v lt max_v val
end

fn sp_fput fbase ulong val ulong w edit ulong 4 to void
role = get sp_tbl fbase
if eq role R_BRA
rel = and sub val 1 4294967295
put w 0 or get w 0 shl and rel 63 18
s = shr rel 6
c = ulong 58720256
if ge rel 2147483648
s = or s 4227858432
c = 58982399
end
put w 1 or get w 1 and shl s 2 4294967295
put w 2 c
ret
end
if eq role R_BSSY
put w 1 or get w 1 and mul sub val 1 16 4294967295
ret
end
if eq role R_LDC
shift = get sp_tbl add fbase 2
put w 1 or get w 1 and shl val shift 16776960
ret
end
if or eq role R_LDSW eq role R_OFF24
put w 1 or get w 1 shl and val 16777215 8
ret
end
if eq role R_FSET
if ne val 0
put w 2 val
else
put w 2 66084864
end
ret
end
word = get sp_tbl add fbase 1
shift = get sp_tbl add fbase 2
width = get sp_tbl add fbase 3
mask = sub shl 1 width 1
val_m = and val mask
cur_w = get w word
put w word or cur_w shl val_m shift
end

fn sp_fenc fbase ulong o view ulong 16 w edit ulong 4 to ulong
role = get sp_tbl fbase
word = get sp_tbl add fbase 1
min_v = get sp_tbl add fbase 5
max_v = get sp_tbl add fbase 6
val = sp_val role word o
ok = sp_chkr role val min_v max_v
if not ok
ret E_RANGE
end
sp_fput fbase val w
ret E_OK
end

fn sp_enc o view ulong 16 w edit ulong 4 to ulong
sp_init
idx = sp_find o
if eq idx 63
ret E_UNSUP
end
base = mul idx 45
put w 0 get sp_tbl add base 2
put w 1 get sp_tbl add base 4
put w 2 get sp_tbl add base 6
ctl = get o 7
if ne ctl 0
put w 3 ctl
else
put w 3 get sp_tbl add base 8
end
nf = get sp_tbl add base 9
for f_i ulong nf
fbase = add add base 10 mul f_i 7
st = sp_fenc fbase o w
if ne st E_OK
ret st
end
end
if eq get sp_tbl base 46
if eq get o 7 0
val = get o 6
if and eq val 0 eq get o 9 0
put w 3 1032192
else
put w 3 1042944
end
end
end
ret E_OK
end

fn sp_dfnd w view ulong 4 to ulong
for i ulong 63
base = mul i 45
w0_fix = get sp_tbl add base 2
w0_mask = get sp_tbl add base 3
if ne and get w 0 w0_mask w0_fix
continue
end
w1_fix = get sp_tbl add base 4
w1_mask = get sp_tbl add base 5
if ne and get w 1 w1_mask w1_fix
continue
end
w2_fix = get sp_tbl add base 6
w2_mask = get sp_tbl add base 7
if ne and get w 2 w2_mask w2_fix
continue
end
ret i
end
ret 63
end

fn sp_dimm role ulong fbase ulong w view ulong 4 o edit ulong 16 to bool
if eq role R_BRA
low6 = and shr get w 0 18 63
hi = and shr get w 1 2 67108863
if or eq get w 2 58982399 ne and get w 1 2147483648 0
if ne and hi 33554432 0
hi = or hi 4227858432
end
end
rel = or shl hi 6 low6
put o 6 and add rel 1 4294967295
ret true
end
if eq role R_BSSY
put o 6 add div get w 1 16 1
ret true
end
if eq role R_LDC
shift = get sp_tbl add fbase 2
put o 6 shr and get w 1 16776960 shift
ret true
end
if or eq role R_LDSW eq role R_OFF24
raw = and shr get w 1 8 16777215
if and eq role R_OFF24 ge raw 8388608
raw = or raw 4278190080
end
put o 6 raw
ret true
end
if eq role R_FSET
put o 6 get w 2
ret true
end
ret false
end

fn sp_fdec fbase ulong w view ulong 4 o edit ulong 16 to void
role = get sp_tbl fbase
is_imm = sp_dimm role fbase w o
if is_imm
ret
end
word = get sp_tbl add fbase 1
shift = get sp_tbl add fbase 2
width = get sp_tbl add fbase 3
mask = sub shl 1 width 1
raw = and shr get w word shift mask
if or eq role R_RD eq role R_URD
put o 1 raw
put o 8 1
ret
end
if or eq role R_RA eq role R_URA
put o 2 raw
put o 12 1
ret
end
if or eq role R_RB eq role R_URB
if eq role R_URB
put o 5 raw
put o 14 1
else
put o 3 raw
put o 13 1
end
ret
end
if eq role R_RC
put o 4 raw
ret
end
if eq role R_PRED3
if eq word 0
put o 1 raw
put o 8 1
else
put o 4 raw
end
ret
end
if eq role R_PRED
if eq raw 0
put o 9 1
put o 10 0
else
if eq raw 8
put o 9 1
put o 10 1
else
put o 9 0
put o 10 0
end
end
ret
end
if eq role R_BAR
put o 11 raw
ret
end
put o 6 raw
end

fn sp_dec w view ulong 4 o edit ulong 16 to ulong
idx = sp_dfnd w
if eq idx 63
ret E_NOMAT
end
for k ulong 16
put o k 0
end
base = mul idx 45
put o 0 get sp_tbl base
put o 7 get w 3
nf = get sp_tbl add base 9
for f_i ulong nf
fbase = add add base 10 mul f_i 7
sp_fdec fbase w o
end
ret E_OK
end


fn main to int
sp_init
o = new ulong 16 0
w = new ulong 4 0
dec = new ulong 16 0

note Test 1: NOP encode and decode
for i ulong 16
put o i 0
end
st = sp_enc o w
if ne st 0
ret 10
end
if ne get w 0 31000
ret 11
end
dst = sp_dec w dec
if ne dst 0
ret 12
end
if ne get dec 0 0
ret 13
end

note Test 2: IMAD encode and decode
for i ulong 16
put o i 0
end
put o 0 8
put o 1 10
put o 2 11
put o 3 12
put o 4 13
put o 13 1
st = sp_enc o w
if ne st 0
ret 20
end
dst = sp_dec w dec
if ne dst 0
ret 21
end
if ne get dec 0 8
ret 22
end
if ne get dec 1 10
ret 23
end
if ne get dec 2 11
ret 24
end
if ne get dec 3 12
ret 25
end
if ne get dec 4 13
ret 26
end

note Test 3: Out-of-range register refusal (register 256)
for i ulong 16
put o i 0
end
put o 0 1
put o 1 256
st2 = sp_enc o w
if ne st2 E_RANGE
ret 30
end

note Test 4: Unsupported opcode refusal
for i ulong 16
put o i 0
end
put o 0 99
st3 = sp_enc o w
if ne st3 E_UNSUP
ret 40
end

note Test 5: Refusal of unmatched bit pattern on decode
put w 0 4294967295
put w 1 4294967295
put w 2 4294967295
put w 3 4294967295
dst = sp_dec w dec
if ne dst E_NOMAT
ret 50
end

ret 0
end
