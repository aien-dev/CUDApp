fn main to int
frame = new uchar 38976 0
pos = ulong 0
while lt pos 38976 bound 38976
n = read 0 frame pos sub 38976 pos
if le n 0
ret 90
end
pos = add pos ulong n
end
launch = new uchar 4096 0
cubin = new uchar 32768 0
obs = new uchar 2048 0
sizes = new ulong 8 0
for i ulong 4096
put launch i get frame i
end
for i ulong 32768
put cubin i get frame add 4096 i
end
for i ulong 2048
put obs i get frame add 36864 i
end
kt_sizes frame sizes
ret kt_cases launch cubin obs sizes
end
