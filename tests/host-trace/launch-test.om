note SPDX-License-Identifier: AGPL-3.0-only
note Host check of native/trace/htlaunch.om over tests/host-trace/fakenv.om (no device). Compose:
note fakenv.om vector.om launch.om htrec.om htlaunch.om launch-test.om. With a path in argv 1 it
note writes the OTR1 dump there. Prints HOSTTRACE_LAUNCH_PASS <checks> or _FAIL <failures>.
global tally ulong 2
global digits uchar 32
global path uchar 4096
text passmsg "HOSTTRACE_LAUNCH_PASS "
text failmsg "HOSTTRACE_LAUNCH_FAIL "
text appnames "launch-test:main|host.upload:a.b|host.verify"
fn number n ulong to void
if ge n 10
number div n 10
end
put digits 0 uchar add 48 rem n 10
w = write 1 digits 0 1
end
fn ck yes bool to void
put tally 0 add get tally 0 1
if not yes
put tally 1 add get tally 1 1
number get tally 0
put digits 0 10
w = write 1 digits 0 1
end
end
fn appname to bool
id = uint 201
ok = htnbeg id
for i ulong len appnames
b = get appnames i
if eq b 124
ok = and ok htnend
id = add id 1
ok = and ok htnbeg id
else
ok = and ok htnbyte b
end
end
ret and ok htnend
end
fn aval i ulong to ulong
ret and add mul i 2654435761 7 4294967295
end
fn bval i ulong to ulong
ret and xor mul i 2246822519 3266489917 4294967295
end
fn upload n uint to void
s = htbeg 6 202
for i ulong ulong n
r = mapset get gbmem 5 mul i 4 4 aval i
r = mapset get gbmem 6 mul i 4 4 bval i
r = mapset get gbmem 7 mul i 4 4 0
end
b = htend s mul ulong n 8 1 0
end
fn readback n uint to ulong
s = htbeg 6 106
bad = ulong 0
for i ulong ulong n
c = mapget get gbmem 7 mul i 4 4
if ne c and add aval i bval i 4294967295
bad = add bad 1
end
end
b = htend s mul ulong n 4 2 long bad
ret bad
end
note count launch spans that ended with stage st and status rc
fn spans st ulong rc long to ulong
k = ulong 0
n = get htst 1
for i ulong n
if eq get htkind i 4
if eq get hta1 i st
if eq get htrc i rc
k = add k 1
end
end
end
end
ret k
end
fn kinds k uint to ulong
c = ulong 0
for i ulong get htst 1
if eq get htkind i k
c = add c 1
end
end
ret c
end
fn opened to void
ck htopen 4097
ck eq get fkn 0 8
for i ulong 8
ck eq get fksz i htgbsz i 4097
end
ck eq kinds 5 8
note event 0 is the launch-test:main span, event 1 the gpu.open span
ck eq get htkind 1 3
ck eq get hta1 1 get gblen 0
ck eq get htrc 1 0
end
fn launched to void
upload 4097
ck htlaunch 4097
ck eq readback 4097 0
ck eq spans 43 0 1
put fkmode 0 1
ck not htlaunch 64
ck eq spans 41 -5 1
put fkmode 0 2
ck not htlaunch 64
ck eq spans 42 -110 1
put fkmode 0 3
ck not htlaunch 64
ck eq spans 43 -5 1
ck eq get nvfault 0 1
put fkmode 0 0
ck not htlaunch 64
ck eq spans 0 -22 1
ck eq get nvstage 0 43
ck not htlaunch 0
ck eq spans 0 -22 2
end
fn dumpto to void
if lt argcnt 2
ret
end
n = argread 1 path 0 4095
ck gt n 0
fd = fopen path 0 ulong n 577 384
ck ge fd 0
r = htdump int fd
ck gt r 0
c = fclose int fd
end
fn main to int
ck appname
ck htlname
ck not htlive
ck htinit
m = htbeg 9 201
opened
launched
ck eq kinds 4 6
ck eq kinds 11 5
ck eq kinds 6 2
ck htend m 0 0 0
ck eq get htst 7 0
ck eq get htst 3 0
ck eq get htst 2 0
dumpto
htstop
ck not htlaunch 64
ck eq kinds 4 6
if ne get tally 1 0
w = write 1 failmsg 0 len failmsg
number get tally 1
put digits 0 10
w = write 1 digits 0 1
ret 1
end
w = write 1 passmsg 0 len passmsg
number get tally 0
put digits 0 10
w = write 1 digits 0 1
ret 0
end
