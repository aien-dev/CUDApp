fn kt_smut launch view uchar 4096 cubin view uchar 32768 obs view uchar 2048 sizes edit ulong 8 off ulong to bool
old = get sizes off
put sizes off xor old 1
rc = native_templates launch cubin obs sizes
put sizes off old
ret eq rc -20
end
fn kt_resign launch edit uchar 4096 obs view uchar 2048 to int
buf = new uchar 4096 0
hash = new uchar 32 0
for i ulong 768
put buf i get obs i
end
if ne kc_sha buf 768 hash 0
ret 1
end
for i ulong 32
put launch add mul ulong 23 8 i get hash i
end
ret 0
end
fn kt_semantic launch edit uchar 4096 cubin view uchar 32768 obs edit uchar 2048 sizes view ulong 8 off ulong to bool
old = get obs off
put obs off xor old 1
if ne kt_resign launch obs 0
ret false
end
rc = native_templates launch cubin obs sizes
put obs off old
if ne kt_resign launch obs 0
ret false
end
ret eq rc -25
end
fn kt_dupsection launch view uchar 4096 cubin edit uchar 32768 obs view uchar 2048 sizes view ulong 8 to bool
backup = new uchar 64 0
sh = kt_u cubin 40 8
src = add sh mul ulong 8 64
sh = add sh mul ulong 7 64
for i ulong 64
put backup i get cubin add sh i
put cubin add sh i get cubin add src i
end
rc = native_templates launch cubin obs sizes
for i ulong 64
put cubin add sh i get backup i
end
ret eq rc -22
end
fn kt_paramhash launch view uchar 4096 cubin edit uchar 32768 obs view uchar 2048 sizes view ulong 8 off ulong to bool
old = kt_u cubin off 4
for i ulong 4
put cubin add off i uchar and shr ulong 1175552 mul i 8 255
end
rc = native_templates launch cubin obs sizes
for i ulong 4
put cubin add off i uchar and shr old mul i 8 255
end
ret eq rc -26
end
fn kt_upperid launch view uchar 4096 cubin view uchar 32768 obs edit uchar 2048 sizes view ulong 8 to bool
old = get obs 1024
put obs 1024 65
rc = native_templates launch cubin obs sizes
put obs 1024 old
ret eq rc -24
end
fn kt_taildupe launch view uchar 4096 cubin edit uchar 32768 obs view uchar 2048 sizes view ulong 8 off ulong to bool
old = get cubin off
put cubin off 55
rc = native_templates launch cubin obs sizes
put cubin off old
ret eq rc -23
end
