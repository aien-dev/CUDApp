note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Scalar binary32 to binary16 IEEE 754-2008 conversion.
note Rounding mode: roundTiesToEven.
note Signed zero preserved. Subnormals rounded with RNE.
note Overflow rounded to signed infinity.
note Quiet and signaling NaNs preserved as quiet NaN with payload and sign.
note Inputs and outputs are raw IEEE bit representations passed as ulong.

fn f16_sub exp ulong m ulong to ulong
if eq exp 112
lsb = and shr m 14 1
r = add add m 8191 lsb
ret shr r 14
end
if eq exp 111
lsb = and shr m 15 1
r = add add m 16383 lsb
ret shr r 15
end
if eq exp 110
lsb = and shr m 16 1
r = add add m 32767 lsb
ret shr r 16
end
if eq exp 109
lsb = and shr m 17 1
r = add add m 65535 lsb
ret shr r 17
end
if eq exp 108
lsb = and shr m 18 1
r = add add m 131071 lsb
ret shr r 18
end
if eq exp 107
lsb = and shr m 19 1
r = add add m 262143 lsb
ret shr r 19
end
if eq exp 106
lsb = and shr m 20 1
r = add add m 524287 lsb
ret shr r 20
end
if eq exp 105
lsb = and shr m 21 1
r = add add m 1048575 lsb
ret shr r 21
end
if eq exp 104
lsb = and shr m 22 1
r = add add m 2097151 lsb
ret shr r 22
end
if eq exp 103
lsb = and shr m 23 1
r = add add m 4194303 lsb
ret shr r 23
end
if eq exp 102
lsb = and shr m 24 1
r = add add m 8388607 lsb
ret shr r 24
end
ret 0
end

fn native_f16 bits ulong to ulong
sign = and shr bits 16 32768
u = and bits 2147483647
if ge u 2139095040
if gt u 2139095040
payload = and shr u 13 1023
res = or 32256 payload
ret or sign res
end
ret or sign 31744
end
if ge u 1199566848
ret or sign 31744
end
if ge u 947912704
lsb = and shr u 13 1
rounded = add add u 4095 lsb
val = sub rounded 939524096
ret or sign shr val 13
end
if gt u 855638016
exp = shr u 23
m = or 8388608 and u 8388607
res = f16_sub exp m
ret or sign res
end
ret sign
end
